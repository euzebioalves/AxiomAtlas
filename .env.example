# Canonical production example. Copy to /opt/axiom-atlas/.env with chmod 600.
APP_VERSION=1.0.17
AXIOM_DOMAIN=CHANGE_ME.example.com
POSTGRES_DB=axiomatlas
POSTGRES_USER=axiomatlas
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=axiomatlas;Username=axiomatlas;Password=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
JwtSettings__SecretKey=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JwtSettings__Issuer=AxiomAtlasApi
JwtSettings__Audience=AxiomAtlasWeb
JwtSettings__ExpirationMinutes=480
DataProtection__KeysPath=/var/lib/axiom-atlas/keys
PublicUrls__WebBaseUrl=https://CHANGE_ME.example.com
PublicUrls__ApplicationName=Axiom Atlas
EmailSettings__SmtpServer=CHANGE_ME
EmailSettings__SmtpPort=587
EmailSettings__SenderName=Axiom Atlas
EmailSettings__SenderEmail=CHANGE_ME
EmailSettings__Username=CHANGE_ME
EmailSettings__Password=CHANGE_ME
Authentication__CookieExpirationMinutes=480
BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_FULL_NAME=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
BACKUP_REMOTE=CHANGE_ME:axiom-atlas
BACKUP_LOCAL_TEST=false
