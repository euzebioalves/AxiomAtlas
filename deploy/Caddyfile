{
    email {$CADDY_EMAIL}
    admin off
    log {
        output file /var/log/caddy/access.json {
            roll_size 25MiB
            roll_keep 10
            roll_keep_for 168h
        }
        format json
        level INFO
    }
}

{$AXIOM_DOMAIN} {
    encode zstd gzip

    # Este endpoint é diagnóstico interno do processo Web e não deve ser exposto pela borda.
    @pdfHealth path /health/pdf
    respond @pdfHealth 404

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    reverse_proxy web:8080 {
        # Caddy preserva o Host original das requisições encaminhadas por padrão.
        # Somente o health check ativo recebe o Host do domínio configurado.
        health_uri /health/live
        health_headers {
            Host {$AXIOM_DOMAIN}
        }
        health_interval 15s
        health_timeout 3s
    }
}
