@{
    ViewData["Title"] = "Gestão de Ausências";
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">@ViewData["Title"]</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted"><a asp-controller="Home" asp-action="Index" class="text-muted text-hover-primary">Home</a></li>
                    <li class="breadcrumb-item"><i class="ki-duotone ki-double-right fs-2"></i></li>
                    <li class="breadcrumb-item text-muted">Tempos</li>
                    <li class="breadcrumb-item"><i class="ki-duotone ki-double-right fs-2"></i></li>
                    <li class="breadcrumb-item text-muted">Gestão de ausências</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-primary" id="btnOpenImport"><i class="ki-duotone ki-file-up fs-2"></i>Importar ausências</button>
                <a asp-controller="TimeClock" asp-action="Index" class="btn btn-light">Voltar ao ponto</a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            <div class="row g-5 g-xl-8 mb-5">
                <div class="col-md-4"><div class="card card-flush h-md-100"><div class="card-body d-flex align-items-center p-6"><span class="symbol symbol-50px me-5"><span class="symbol-label bg-light-primary"><i class="ki-duotone ki-calendar-tick fs-2x text-primary"></i></span></span><div><span class="fs-2hx fw-bold" id="absenceTotal">0</span><div class="text-gray-600 fw-semibold">Ausências registradas</div></div></div></div></div>
                <div class="col-md-4"><div class="card card-flush h-md-100"><div class="card-body d-flex align-items-center p-6"><span class="symbol symbol-50px me-5"><span class="symbol-label bg-light-success"><i class="ki-duotone ki-file fs-2x text-success"></i></span></span><div><span class="fs-2hx fw-bold" id="attachmentTotal">0</span><div class="text-gray-600 fw-semibold">Anexos disponíveis</div></div></div></div></div>
                <div class="col-md-4"><div class="card card-flush h-md-100"><div class="card-body d-flex align-items-center p-6"><span class="symbol symbol-50px me-5"><span class="symbol-label bg-light-danger"><i class="ki-duotone ki-information fs-2x text-danger"></i></span></span><div><span class="fs-2hx fw-bold" id="unjustifiedTotal">0</span><div class="text-gray-600 fw-semibold">Faltas sem justificativa</div></div></div></div></div>
            </div>

            <div class="card card-flush">
                <div class="card-header border-0 pt-6">
                    <div class="card-title"><div class="d-flex align-items-center position-relative my-1"><i class="ki-duotone ki-magnifier fs-3 position-absolute ms-5"></i><input type="text" id="searchInput" class="form-control form-control-solid w-300px ps-13" placeholder="Pesquisar ausência"></div></div>
                    <div class="card-toolbar"><select id="typeFilter" class="form-select form-select-solid w-200px"><option value="">Todos os tipos</option><option value="MedicalCertificate">Atestado médico</option><option value="Vacation">Férias</option><option value="HomeOffice">Home office</option><option value="unjustified">Falta sem justificativa</option></select></div>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive"><table class="table align-middle table-row-dashed fs-6 gy-5">
                        <thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0"><th>Ausência</th><th>Período</th><th>Descrição</th><th>Origem</th><th class="text-end">Anexos</th></tr></thead>
                        <tbody class="text-gray-600 fw-semibold" id="absenceTable"><tr><td colspan="5" class="text-center py-10"><span class="spinner-border spinner-border-sm text-primary me-2"></span>Carregando ausências...</td></tr></tbody>
                    </table></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importAbsencesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-700px"><div class="modal-content"><form id="importAbsencesForm">
        <div class="modal-header"><div><h2 class="fw-bold mb-1">Importar ausências históricas</h2><div class="text-muted fw-semibold">CSV do sistema anterior e a pasta de anexos correspondente.</div></div><div class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal"><i class="ki-duotone ki-cross fs-1"></i></div></div>
        <div class="modal-body">
            <div class="notice d-flex bg-light-warning rounded border-warning border border-dashed p-6 mb-7"><i class="ki-duotone ki-information-5 fs-2tx text-warning me-4"></i><div class="fw-semibold"><div class="fs-6 text-gray-700">Substituição integral das ausências</div><div class="text-gray-600">Depois da validação, as ausências e faltas sem justificativa atuais serão removidas e substituídas pelos dados importados, incluindo os anexos.</div></div></div>
            <div class="mb-6"><label class="required form-label fw-semibold">Arquivo CSV de ausências</label><input class="form-control form-control-solid" type="file" name="csvFile" accept=".csv,text/csv" required></div>
            <div class="mb-6"><label class="form-label fw-semibold">Pasta de anexos</label><input class="form-control form-control-solid" type="file" name="attachments" webkitdirectory directory multiple><div class="form-text">Selecione a pasta <code>anexos</code> fornecida junto ao CSV. Os arquivos são associados pelo ID da ausência.</div></div>
            <div class="mb-6"><label class="form-label fw-semibold">Alternativa: arquivos de anexo</label><input class="form-control form-control-solid" type="file" name="attachments" multiple><div class="form-text">Caso seu navegador não permita selecionar uma pasta, selecione todos os arquivos da pasta <code>anexos</code>.</div></div>
            <label class="form-check form-check-custom form-check-solid"><input class="form-check-input" type="checkbox" name="replaceExisting" value="true" required><span class="form-check-label fw-semibold text-gray-700">Entendo que as ausências atuais desta conta serão substituídas.</span></label>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" id="btnImportAbsences" class="btn btn-primary"><span class="indicator-label"><i class="ki-duotone ki-file-up fs-2"></i>Validar e importar</span><span class="indicator-progress">Importando... <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span></button></div>
    </form></div></div>
</div>

@section Scripts {
<script>
    let absenceItems = [];
    let importModal;
    document.addEventListener('DOMContentLoaded', () => {
        importModal = new bootstrap.Modal(document.getElementById('importAbsencesModal'));
        document.getElementById('btnOpenImport').addEventListener('click', () => { document.getElementById('importAbsencesForm').reset(); importModal.show(); });
        document.getElementById('importAbsencesForm').addEventListener('submit', importAbsences);
        document.getElementById('searchInput').addEventListener('input', renderTable);
        document.getElementById('typeFilter').addEventListener('change', renderTable);
        loadAbsences();
    });

    async function loadAbsences() {
        try { absenceItems = await readJson(await fetch('/TimeClock/GetAbsenceManagement')); renderSummary(); renderTable(); }
        catch (error) { document.getElementById('absenceTable').innerHTML = `<tr><td colspan="5" class="text-center text-danger py-10">${escapeHtml(error.message)}</td></tr>`; }
    }
    function renderSummary() {
        document.getElementById('absenceTotal').textContent = absenceItems.length;
        document.getElementById('attachmentTotal').textContent = absenceItems.reduce((sum, item) => sum + item.attachments.length, 0);
        document.getElementById('unjustifiedTotal').textContent = absenceItems.filter(item => item.isUnjustified).length;
    }
    function renderTable() {
        const search = document.getElementById('searchInput').value.toLocaleLowerCase(); const type = document.getElementById('typeFilter').value;
        const items = absenceItems.filter(item => (!type || (type === 'unjustified' ? item.isUnjustified : item.type === type)) && `${item.typeLabel} ${item.observation || ''} ${item.startDate}`.toLocaleLowerCase().includes(search));
        document.getElementById('absenceTable').innerHTML = items.length ? items.map(item => `<tr><td><div class="d-flex align-items-center"><span class="symbol symbol-40px me-3"><span class="symbol-label ${item.isUnjustified ? 'bg-light-danger' : 'bg-light-primary'}"><i class="ki-duotone ${item.isUnjustified ? 'ki-information' : 'ki-calendar-tick'} fs-2 text-${item.isUnjustified ? 'danger' : 'primary'}"></i></span></span><div><span class="text-gray-800 fw-bold d-block">${escapeHtml(item.typeLabel)}</span><span class="text-muted fs-7">${escapeHtml(item.periodTypeLabel)}</span></div></div></td><td><span class="text-gray-800">${formatDate(item.startDate)}${item.endDate !== item.startDate ? ` até ${formatDate(item.endDate)}` : ''}</span>${item.startTime ? `<div class="text-muted fs-7">${item.startTime} às ${item.endTime}</div>` : ''}</td><td><span class="text-gray-700">${escapeHtml(item.observation || 'Sem descrição')}</span></td><td>${item.externalRecordId ? `<span class="badge badge-light-success">Importado</span><div class="text-muted fs-8 mt-1">ID: ${escapeHtml(item.externalRecordId)}</div>` : '<span class="badge badge-light">Manual</span>'}</td><td class="text-end">${item.attachments.length ? item.attachments.map(file => `<a class="btn btn-sm btn-light-primary me-1 mb-1" href="/TimeClock/DownloadAbsenceAttachment/${item.id}/${file.id}" title="${escapeAttribute(file.fileName)}"><i class="ki-duotone ki-file-down fs-3"></i>${escapeHtml(file.fileName)}</a>`).join('') : '<span class="text-muted fs-7">Sem anexo</span>'}</td></tr>`).join('') : '<tr><td colspan="5" class="text-center text-muted py-10">Nenhuma ausência encontrada.</td></tr>';
    }
    async function importAbsences(event) {
        event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity()) return; const button = document.getElementById('btnImportAbsences'); button.disabled = true; button.setAttribute('data-kt-indicator', 'on');
        try { const response = await fetch('/TimeClock/ImportAbsences', { method: 'POST', body: new FormData(form) }); const payload = await response.json().catch(() => ({})); if (!response.ok) { const issues = (payload.errors || []).slice(0, 8).map(issue => `Linha ${issue.line ?? '?'}: ${issue.message}`).join('\n'); throw new Error(issues ? `${payload.message}\n\n${issues}` : (payload.message || 'Não foi possível importar as ausências.')); } importModal.hide(); await loadAbsences(); showMessage(`${payload.importedAbsences} ausências, ${payload.importedUnjustifiedAbsences} falta(s) e ${payload.importedAttachments} anexo(s) importados.`, 'success'); }
        catch (error) { showMessage(error.message, 'error'); }
        finally { button.disabled = false; button.removeAttribute('data-kt-indicator'); }
    }
    async function readJson(response) { const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.message || 'Não foi possível concluir a operação.'); return payload; }
    function formatDate(value) { const [year, month, day] = value.split('-'); return `${day}/${month}/${year}`; }
    function escapeHtml(value) { const element = document.createElement('div'); element.textContent = value || ''; return element.innerHTML; }
    function escapeAttribute(value) { return escapeHtml(value).replace(/"/g, '&quot;'); }
    function showMessage(text, icon) { if (window.Swal) { Swal.fire({ text, icon, buttonsStyling: false, confirmButtonText: 'Ok', customClass: { confirmButton: `btn fw-bold btn-${icon === 'error' ? 'danger' : 'primary'}` } }); } else alert(text); }
</script>
}
