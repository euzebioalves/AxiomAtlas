@{
    ViewData["Title"] = "Ponto Eletrônico";
}

@section Styles {
    <link href="~/metronic8/css/fullcalendar.bundle.css" rel="stylesheet" type="text/css" />
    <style>
    #clockCalendar .fc-daygrid-day {
        cursor: pointer;
        transition: background-color .18s ease;
    }

    #clockCalendar .fc-daygrid-day:hover {
        background-color: var(--bs-primary-light);
    }

    #clockCalendar {
        --time-clock-special-surface: rgba(148, 163, 184, .045);
        --time-clock-special-text: #64748b;
        --time-clock-grid-border: rgba(148, 163, 184, .2);
        --time-clock-day-surface: var(--bs-body-bg);
        --time-clock-day-shadow: 0 .35rem 1rem rgba(15, 23, 42, .055);
        --time-clock-day-hover-shadow: 0 .8rem 1.5rem rgba(15, 23, 42, .11);
    }

    [data-bs-theme="dark"] #clockCalendar {
        --time-clock-special-surface: rgba(148, 163, 184, .075);
        --time-clock-special-text: #b7c3d5;
        --time-clock-grid-border: rgba(148, 163, 184, .24);
        --time-clock-day-surface: rgba(30, 33, 48, .78);
        --time-clock-day-shadow: 0 .35rem 1rem rgba(0, 0, 0, .2);
        --time-clock-day-hover-shadow: 0 .8rem 1.5rem rgba(0, 0, 0, .3);
    }

    #clockCalendar .fc-scrollgrid,
    #clockCalendar .fc-theme-standard .fc-scrollgrid {
        border: 0;
        border-collapse: separate;
        border-spacing: .55rem .65rem;
    }

    #clockCalendar .fc-scrollgrid-sync-table {
        border-collapse: separate !important;
        border-spacing: .55rem .65rem !important;
    }

    #clockCalendar .fc-theme-standard td,
    #clockCalendar .fc-theme-standard th,
    #clockCalendar .fc-scrollgrid-section > td,
    #clockCalendar .fc-scrollgrid-section > th {
        border: 0;
    }

    #clockCalendar .fc-col-header-cell {
        background: transparent;
        padding: 0 0 .25rem;
    }

    #clockCalendar .fc-col-header-cell-cushion {
        color: var(--bs-gray-600);
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-decoration: none;
        text-transform: uppercase;
    }

    #clockCalendar .fc-daygrid-day {
        overflow: hidden;
        border: 1px solid var(--time-clock-grid-border) !important;
        border-radius: .85rem;
        background: var(--time-clock-day-surface);
        box-shadow: var(--time-clock-day-shadow);
    }

    #clockCalendar .fc-daygrid-day.fc-day-sun,
    #clockCalendar .fc-daygrid-day.fc-day-sat,
    #clockCalendar .fc-daygrid-day.time-clock-special-day {
        background: var(--time-clock-special-surface);
    }

    #clockCalendar .fc-daygrid-day.fc-day-sun .fc-daygrid-day-number,
    #clockCalendar .fc-daygrid-day.fc-day-sat .fc-daygrid-day-number,
    #clockCalendar .fc-daygrid-day.time-clock-special-day .fc-daygrid-day-number {
        color: var(--time-clock-special-text);
        font-weight: 700;
    }

    #clockCalendar .fc-day-today {
        border-color: rgba(var(--bs-primary-rgb), .5) !important;
        background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), .13), var(--time-clock-day-surface)) !important;
        box-shadow: 0 .65rem 1.5rem rgba(var(--bs-primary-rgb), .14);
    }

    #clockCalendar .fc-day-today .fc-daygrid-day-number {
        color: var(--bs-primary);
        font-weight: 800;
    }

    #clockCalendar .time-clock-has-absence {
        box-shadow: inset 3px 0 0 var(--bs-success);
    }

    #clockCalendar .time-clock-has-unjustified {
        box-shadow: inset 3px 0 0 var(--bs-danger);
    }

    #clockCalendar .time-clock-punch-complete {
        box-shadow: inset 4px 0 0 var(--bs-success), var(--time-clock-day-shadow);
    }

    #clockCalendar .time-clock-punch-incomplete {
        box-shadow: inset 4px 0 0 var(--bs-danger), var(--time-clock-day-shadow);
    }

    #clockCalendar .fc-daygrid-day-events {
        min-height: 4.75rem;
        padding: 0 .25rem .3rem;
    }

    #clockCalendar .fc-daygrid-day-frame {
        position: relative;
        min-height: 8.75rem;
        padding: .25rem;
    }

    #clockCalendar .fc-daygrid-day-top {
        display: flex;
        flex-direction: row !important;
        align-items: flex-start;
        justify-content: space-between;
        min-height: 2.7rem;
        padding: .35rem .45rem 0;
    }

    #clockCalendar .fc-daygrid-day-number {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        min-width: 2.5rem;
        height: 2.35rem;
        color: var(--bs-gray-900);
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
    }

    #clockCalendar .time-clock-day-header-indicators {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        margin-left: auto;
        padding-top: .05rem;
    }

    #clockCalendar .time-clock-day-punch-count,
    #clockCalendar .time-clock-day-indicator {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        border-radius: .5rem;
        border: 1px solid transparent;
        box-shadow: none;
        transition: color .18s ease, background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    #clockCalendar .time-clock-day-punch-count {
        gap: .16rem;
        padding: 0 .42rem;
        color: var(--bs-primary);
        background: var(--bs-primary-light);
        border-color: var(--bs-primary);
        font-size: .75rem;
        font-weight: 800;
        line-height: 1;
        cursor: help;
    }

    #clockCalendar .time-clock-day-punch-count:hover,
    #clockCalendar .time-clock-day-indicator:hover {
        box-shadow: 0 .25rem .65rem rgba(15, 23, 42, .24);
        transform: translateY(-1px);
    }

    #clockCalendar .time-clock-day-punch-count i {
        font-size: .9rem !important;
    }

    #clockCalendar .time-clock-day-punch-count i,
    #clockCalendar .time-clock-day-punch-count i::before,
    #clockCalendar .time-clock-day-punch-count i::after {
        color: var(--bs-primary) !important;
    }

    #clockCalendar .time-clock-day-indicator i {
        font-size: 1rem !important;
    }

    #clockCalendar .fc-daygrid-event-harness {
        margin-top: .16rem;
    }

    #clockCalendar .fc-daygrid-event {
        overflow: hidden;
        border: 0;
        border-radius: .45rem;
        background: var(--bs-primary-light);
        color: var(--bs-primary);
        font-size: .71rem;
        font-weight: 700;
        line-height: 1.25;
        padding: .18rem .35rem;
    }

    #clockCalendar .fc-daygrid-event .fc-event-title {
        white-space: normal;
    }

    #clockCalendar .fc-daygrid-more-link {
        display: none !important;
    }

    #clockCalendar .fc-event {
        cursor: pointer;
    }

    #clockCalendar .time-clock-day-work-packages {
        display: flex;
        flex-wrap: wrap;
        gap: .25rem;
        padding: .25rem .15rem .1rem;
    }

    #clockCalendar .time-clock-day-work-package-total {
        display: inline-flex;
        align-items: center;
        gap: .2rem;
        width: 100%;
        color: var(--bs-gray-700);
        font-size: .72rem;
        font-weight: 700;
        line-height: 1.1;
    }

    #clockCalendar .time-clock-work-package-badge {
        display: inline-flex;
        align-items: center;
        min-height: 1.55rem;
        border: 1px solid transparent;
        font-size: .75rem;
        font-weight: 700;
        line-height: 1.1;
        text-decoration: none;
    }

    #clockCalendar a.time-clock-work-package-badge:hover {
        filter: brightness(.92);
        text-decoration: underline;
    }

    #clockCalendar .fc-daygrid-day:hover {
        border-color: rgba(var(--bs-primary-rgb), .4) !important;
        box-shadow: var(--time-clock-day-hover-shadow);
        transform: translateY(-2px);
    }

    #clockCalendar .fc-daygrid-more-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.8rem;
        height: 1.8rem;
        color: var(--bs-primary);
        background: var(--bs-primary-light);
        border-radius: .45rem;
        text-decoration: none;
    }

    #clockCalendar .fc-daygrid-more-link:hover {
        color: var(--bs-primary-inverse);
        background: var(--bs-primary);
    }

    #clockCalendar .time-clock-day-indicator {
        cursor: help;
    }

    #clockCalendar .time-clock-indicator-medical {
        color: var(--bs-danger);
        background-color: var(--bs-danger-light);
        border-color: var(--bs-danger);
    }

    #clockCalendar .time-clock-indicator-warning {
        color: var(--bs-warning);
        background-color: var(--bs-warning-light);
        border-color: var(--bs-warning);
    }

    #clockCalendar .time-clock-indicator-primary {
        color: var(--bs-primary);
        background-color: var(--bs-primary-light);
        border-color: var(--bs-primary);
    }

    #clockCalendar .time-clock-indicator-success {
        color: var(--bs-success);
        background-color: var(--bs-success-light);
        border-color: var(--bs-success);
    }

    #clockCalendar .time-clock-indicator-danger {
        color: var(--bs-danger);
        background-color: var(--bs-danger-light);
        border-color: var(--bs-danger);
    }

    #clockCalendar .time-clock-indicator-medical i,
    #clockCalendar .time-clock-indicator-medical i::before,
    #clockCalendar .time-clock-indicator-medical i::after,
    #clockCalendar .time-clock-indicator-danger i,
    #clockCalendar .time-clock-indicator-danger i::before,
    #clockCalendar .time-clock-indicator-danger i::after {
        color: var(--bs-danger) !important;
    }

    #clockCalendar .time-clock-indicator-warning i,
    #clockCalendar .time-clock-indicator-warning i::before,
    #clockCalendar .time-clock-indicator-warning i::after {
        color: var(--bs-warning) !important;
    }

    #clockCalendar .time-clock-indicator-primary i,
    #clockCalendar .time-clock-indicator-primary i::before,
    #clockCalendar .time-clock-indicator-primary i::after {
        color: var(--bs-primary) !important;
    }

    #clockCalendar .time-clock-indicator-success i,
    #clockCalendar .time-clock-indicator-success i::before,
    #clockCalendar .time-clock-indicator-success i::after {
        color: var(--bs-success) !important;
    }

    #clockCalendar .time-clock-day-punch-count:hover {
        color: var(--bs-primary-inverse);
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    #clockCalendar .time-clock-indicator-medical:hover,
    #clockCalendar .time-clock-indicator-danger:hover {
        color: var(--bs-danger-inverse);
        background-color: var(--bs-danger);
        border-color: var(--bs-danger);
    }

    #clockCalendar .time-clock-indicator-warning:hover {
        color: var(--bs-warning-inverse);
        background-color: var(--bs-warning);
        border-color: var(--bs-warning);
    }

    #clockCalendar .time-clock-indicator-primary:hover {
        color: var(--bs-primary-inverse);
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    #clockCalendar .time-clock-indicator-success:hover {
        color: var(--bs-success-inverse);
        background-color: var(--bs-success);
        border-color: var(--bs-success);
    }

    #clockCalendar .time-clock-day-punch-count:hover i,
    #clockCalendar .time-clock-day-punch-count:hover i::before,
    #clockCalendar .time-clock-day-punch-count:hover i::after,
    #clockCalendar .time-clock-day-indicator:hover i,
    #clockCalendar .time-clock-day-indicator:hover i::before,
    #clockCalendar .time-clock-day-indicator:hover i::after {
        color: #fff !important;
    }

    #clockCalendar .time-clock-has-absence {
        box-shadow: inset 4px 0 0 var(--bs-success), var(--time-clock-day-shadow);
    }

    #clockCalendar .time-clock-has-unjustified {
        box-shadow: inset 4px 0 0 var(--bs-danger), var(--time-clock-day-shadow);
    }

    @@media (max-width: 991.98px) {
        #clockCalendar .fc-scrollgrid,
        #clockCalendar .fc-theme-standard .fc-scrollgrid,
        #clockCalendar .fc-scrollgrid-sync-table {
            border-spacing: .35rem .45rem !important;
        }

        #clockCalendar .fc-daygrid-day-frame {
            min-height: 7.5rem;
        }
    }

    @@media (max-width: 575.98px) {
        #clockCalendar .fc-scrollgrid,
        #clockCalendar .fc-theme-standard .fc-scrollgrid,
        #clockCalendar .fc-scrollgrid-sync-table {
            border-spacing: .16rem .25rem !important;
        }

        #clockCalendar .fc-daygrid-day-frame {
            min-height: 6.15rem;
            padding: .1rem;
        }

        #clockCalendar .fc-daygrid-day-events {
            min-height: 3.9rem;
            padding: 0 .1rem;
        }

        #clockCalendar .fc-daygrid-day-number {
            min-width: 1.7rem;
            height: 1.7rem;
            font-size: .95rem;
        }

        #clockCalendar .fc-col-header-cell-cushion {
            font-size: .62rem;
        }

        #clockCalendar .time-clock-work-package-badge {
            min-height: 1.3rem;
            font-size: .65rem;
        }

        #clockCalendar .time-clock-day-punch-count,
        #clockCalendar .time-clock-day-indicator {
            min-width: 1.4rem;
            height: 1.4rem;
            padding: 0 .25rem;
        }
    }

    .time-clock-period-controls {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .time-clock-period-controls .btn,
    .time-clock-period-controls .form-control {
        min-height: 34px;
        white-space: nowrap;
    }

    .time-clock-period-controls .form-control {
        width: 154px;
    }

    .time-clock-legend-button {
        width: 34px;
        height: 34px;
    }

    @@media (max-width: 767.98px) {
        .time-clock-period-controls {
            width: 100%;
        }

        .time-clock-period-controls .form-control {
            flex: 1 1 auto;
            width: auto;
        }

        .time-clock-period-controls .time-clock-period-label {
            display: none;
        }
    }

    .balance-positive {
        color: var(--bs-success);
    }

    .balance-negative {
        color: var(--bs-danger);
    }

    .balance-zero {
        color: var(--bs-gray-600);
    }

    .punch-row {
        border: 1px dashed var(--bs-border-color);
        border-radius: .95rem;
        padding: 1rem;
        background: rgba(255, 255, 255, .02);
    }

    </style>
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                    @ViewData["Title"]
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a asp-controller="Home" asp-action="Index" class="text-muted text-hover-primary">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <i class="ki-duotone ki-double-right fs-2"></i>
                    </li>
                    <li class="breadcrumb-item text-muted">Tempos</li>
                    <li class="breadcrumb-item">
                        <i class="ki-duotone ki-double-right fs-2"></i>
                    </li>
                    <li class="breadcrumb-item text-muted">Calendário mensal de ponto</li>
                </ul>
            </div>
            <div class="dropdown">
                <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2" type="button" id="timeClockActions" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ki-duotone ki-category fs-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span></i>
                    Ações
                    <i class="ki-duotone ki-down fs-5"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold fs-7 w-225px py-4" aria-labelledby="timeClockActions">
                    <div class="menu-item px-3"><button class="menu-link w-100 border-0 bg-transparent text-start" id="btnOpenAbsenceModal" type="button"><i class="ki-duotone ki-plus fs-3 me-3 text-success"></i>Cadastrar ausência</button></div>
                    <div class="menu-item px-3"><a asp-controller="TimeClock" asp-action="Absences" class="menu-link"><i class="ki-duotone ki-calendar-tick fs-3 me-3 text-warning"></i>Gerenciar ausências</a></div>
                    <div class="separator my-2"></div>
                    <div class="menu-item px-3"><button class="menu-link w-100 border-0 bg-transparent text-start" id="btnOpenImportModal" type="button"><i class="ki-duotone ki-file-up fs-3 me-3 text-success"></i>Importar CSV</button></div>
                    <div class="menu-item px-3"><a asp-controller="TimeClock" asp-action="Settings" class="menu-link"><i class="ki-duotone ki-setting-2 fs-3 me-3 text-primary"></i>Minha jornada</a></div>
                    <div class="menu-item px-3"><a asp-controller="TimeClock" asp-action="Audit" class="menu-link"><i class="ki-duotone ki-chart-simple fs-3 me-3 text-gray-600"></i>Auditoria do ponto</a></div>
                </div>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-5 g-xl-8 mb-5 mb-xl-8">
                <div class="col">
                    <div class="card card-flush h-xl-100">
                        <div class="card-body d-flex align-items-center p-6">
                            <div class="symbol symbol-50px me-5"><span class="symbol-label bg-light-danger"><i class="ki-duotone ki-chart-simple fs-2x text-danger"><span class="path1"></span><span class="path2"></span></i></span></div>
                            <div class="d-flex flex-column">
                                <span class="fs-2hx fw-bold lh-1 ls-n2" id="summaryTotalBalance">0h00</span>
                                <span class="text-gray-600 fw-semibold fs-6 mt-2">Banco de horas</span>
                                <span class="text-gray-500 fw-semibold fs-7 mt-1">Saldo acumulado</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card card-flush h-xl-100">
                        <div class="card-body d-flex align-items-center p-6">
                            <div class="symbol symbol-50px me-5"><span class="symbol-label bg-light-primary"><i class="ki-duotone ki-wallet fs-2x text-primary"><span class="path1"></span><span class="path2"></span></i></span></div>
                            <div class="d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 ls-n2" id="summaryBalance">0h00</span>
                                <span class="text-gray-600 fw-semibold fs-6 mt-2">Saldo do mês</span>
                                <span class="text-gray-500 fw-semibold fs-7 mt-1">Calculado até hoje</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card card-flush h-xl-100">
                        <div class="card-body d-flex align-items-center p-6">
                            <div class="symbol symbol-50px me-5"><span class="symbol-label bg-light-success"><i class="ki-duotone ki-time fs-2x text-success"><span class="path1"></span><span class="path2"></span></i></span></div>
                            <div class="d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 ls-n2" id="summaryWorked">0h00</span>
                                <span class="text-gray-600 fw-semibold fs-6 mt-2">Horas registradas</span>
                                <span class="text-gray-500 fw-semibold fs-7 mt-1">Lançamentos até hoje</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card card-flush h-xl-100">
                        <div class="card-body d-flex align-items-center p-6">
                            <div class="symbol symbol-50px me-5"><span class="symbol-label bg-light-info"><i class="ki-duotone ki-calendar-tick fs-2x text-info"><span class="path1"></span><span class="path2"></span></i></span></div>
                            <div class="d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 ls-n2" id="summaryExpected">0h00</span>
                                <span class="text-gray-600 fw-semibold fs-6 mt-2">Horas previstas</span>
                                <span class="text-gray-500 fw-semibold fs-7 mt-1">Jornada até hoje</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card card-flush h-xl-100">
                        <div class="card-body d-flex align-items-center p-6">
                            <div class="symbol symbol-50px me-5"><span class="symbol-label bg-light-warning"><i class="ki-duotone ki-shield-tick fs-2x text-warning"><span class="path1"></span><span class="path2"></span></i></span></div>
                            <div class="d-flex flex-column">
                                <span class="fs-2hx fw-bold text-gray-900 lh-1 ls-n2" id="summaryTolerance">0 min</span>
                                <span class="text-gray-600 fw-semibold fs-6 mt-2">Tolerância global</span>
                                <span class="text-gray-500 fw-semibold fs-7 mt-1">Regra de compensação</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-5 mb-xl-8">
                <div class="card-header border-0 pt-6">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold fs-3" id="calendarTitle">Calendário</span>
                        <span class="text-muted mt-1 fw-semibold fs-7" id="calendarSubtitle">Carregando...</span>
                    </h3>
                    <div class="card-toolbar flex-wrap gap-2">
                        <label class="form-check form-switch form-check-custom form-check-solid align-items-center me-2">
                            <input class="form-check-input" type="checkbox" id="showWorkPackagesInCalendar" disabled />
                            <span class="form-check-label fw-semibold text-muted fs-7">Exibir WPs</span>
                        </label>
                        <div class="time-clock-period-controls">
                            <button class="btn btn-sm btn-light d-inline-flex align-items-center justify-content-center gap-1" id="btnPreviousMonth" type="button" title="Mês anterior">
                                <i class="ki-duotone ki-left fs-4"></i><span class="time-clock-period-label">Mês anterior</span>
                            </button>
                            <input type="month" id="monthPicker" class="form-control form-control-sm form-control-solid" aria-label="Selecionar mês">
                            <button class="btn btn-sm btn-light d-inline-flex align-items-center justify-content-center gap-1" id="btnNextMonth" type="button" title="Próximo mês">
