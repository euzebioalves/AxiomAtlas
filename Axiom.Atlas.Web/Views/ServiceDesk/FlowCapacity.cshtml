@{
    ViewData["Title"] = "Fluxo e capacidade";
}

<div class="app-content flex-column-fluid" id="kt_app_content">
    <div class="app-container container-fluid">
        <div class="d-flex flex-column gap-7">
            <div class="card flow-hero"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-5 py-7"><div><span class="badge badge-light-primary mb-3">Visão gerencial</span><h1 class="fs-2x fw-bold mb-2">Fluxo e capacidade</h1><p class="text-gray-600 fw-semibold mb-0">Localize gargalos no processo e acompanhe a distribuição técnica das demandas em andamento.</p><p id="flow-synchronization" class="text-gray-500 fs-7 mt-3 mb-0"></p></div><div class="d-flex flex-wrap gap-3"><button type="button" class="btn btn-light-primary management-help-trigger" data-management-help-key="flow" data-management-help-title="Como interpretar o fluxo" aria-label="Como interpretar o fluxo"><span class="management-help-question me-2">?</span>Como interpretar</button><a asp-action="Dashboard" class="btn btn-light-primary"><i class="ki-duotone ki-chart-line-star fs-2"><span class="path1"></span><span class="path2"></span></i>Painel executivo</a><button id="flow-refresh" type="button" class="btn btn-primary"><i class="ki-duotone ki-arrows-circle fs-2"><span class="path1"></span><span class="path2"></span></i>Atualizar fontes</button></div></div></div>
            <div id="flow-error" class="alert alert-danger d-none mb-0"><span id="flow-error-message"></span></div>
            <div id="flow-loading" class="card"><div class="card-body d-flex align-items-center justify-content-center gap-3 py-12"><span class="spinner-border text-primary" role="status"></span><span class="fw-semibold text-gray-600">Preparando a visão do fluxo...</span></div></div>

            <div id="flow-content" class="d-none d-flex flex-column gap-7">
                <div class="row g-5" id="flow-kpis"></div>
                <div class="row g-7">
                    <div class="col-xl-6"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Gargalos por etapa <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="flow" data-management-help-title="Gargalos por etapa" aria-label="Entenda os gargalos por etapa"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Concentração atual da fila por etapa do processo.</span></div></div><div class="card-body pt-2" id="flow-stages"></div></div></div>
                    <div class="col-xl-6"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Referência de distribuição técnica <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="capacity" data-management-help-title="Referência de distribuição técnica" aria-label="Entenda a distribuição técnica"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Agrupamento pelo criador da Work Package, não pelo responsável atribuído.</span></div></div><div class="card-body pt-2" id="flow-capacity"></div></div></div>
                </div>
                <div class="card"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Impedimentos e decisões prioritárias <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="blockers" data-management-help-title="Impedimentos e decisões prioritárias" aria-label="Entenda a fila de impedimentos"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Demandas em atenção, risco ou criticidade que precisam de uma ação do fluxo.</span></div></div><div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0"><thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase"><th>Demanda</th><th>Etapa</th><th>Referência técnica</th><th>Motivo da prioridade</th><th class="text-end">Ação</th></tr></thead><tbody id="flow-blockers"></tbody></table></div></div></div>
            </div>
        </div>
    </div>
</div>

<partial name="_ManagementDashboardHelp" />

<style>
    .flow-hero { background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), .10), rgba(var(--bs-warning-rgb), .06)); }
    .flow-kpi { min-height: 150px; } .flow-kpi-value { font-size: 2rem; line-height: 1; }
    .flow-item + .flow-item { border-top: 1px dashed var(--bs-border-color); }
    .flow-bar { height: 8px; border-radius: 99px; background: var(--bs-gray-200); overflow: hidden; } .flow-bar > span { display: block; height: 100%; border-radius: inherit; }
    [data-bs-theme="dark"] .flow-bar { background: #242838; }
</style>

<script>
    (() => {
        const loading = document.getElementById('flow-loading'), content = document.getElementById('flow-content'), error = document.getElementById('flow-error'), errorMessage = document.getElementById('flow-error-message'), refreshButton = document.getElementById('flow-refresh');
        const dataUrl = '@Url.Action("DashboardData", "ServiceDesk")', refreshUrl = '@Url.Action("RefreshKanban", "ServiceDesk")', detailsUrl = '@Url.Action("DashboardDetails", "ServiceDesk")';
        const escapeHtml = value => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        const formatDateTime = value => value ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(value)) : 'Ainda não sincronizada';
        const formatInterval = seconds => seconds >= 60 ? `${Math.round(seconds / 60)} min` : `${seconds} s`;
        const stages = [{ key: 'attention', label: 'Atenção necessária', color: 'danger' }, { key: 'triage', label: 'Triagem GLPI', color: 'primary' }, { key: 'analysis', label: 'Análise de requisitos', color: 'warning' }, { key: 'delivery', label: 'Em desenvolvimento', color: 'success' }, { key: 'completed', label: 'Concluídas', color: 'info' }];
        const priorityClass = priority => priority === 'Crítica' ? 'danger' : priority === 'Alta' ? 'warning' : 'primary';

        async function loadFlow() {
            loading.classList.remove('d-none'); content.classList.add('d-none'); error.classList.add('d-none');
            try { const response = await fetch(dataUrl); const raw = await response.text(); let payload; try { payload = raw ? JSON.parse(raw) : null; } catch { throw new Error(`A consulta retornou uma resposta inválida (HTTP ${response.status}).`); } if (!response.ok || !payload) throw new Error(payload?.message || payload?.detail || `Não foi possível carregar o fluxo (HTTP ${response.status}).`); renderFlow(payload); content.classList.remove('d-none'); }
            catch (exception) { errorMessage.textContent = exception.message; error.classList.remove('d-none'); }
            finally { loading.classList.add('d-none'); }
        }

        function renderFlow(payload) {
            const items = payload.items || [], summary = payload.summary || {}, openItems = items.filter(item => item.stage !== 'completed');
            document.getElementById('flow-synchronization').textContent = payload.synchronizationPending ? 'Uma atualização está em andamento. O fluxo será reconciliado em segundo plano.' : `Projeção local atualizada em ${formatDateTime(payload.lastSynchronizedAt)}. Fontes reconciliadas a cada ${formatInterval(payload.synchronizationIntervalSeconds || 300)}.`;
            const unlinked = openItems.filter(item => !item.workPackageId).length, withoutCreator = openItems.filter(item => item.stage === 'delivery' && !item.workPackageCreator).length;
            const kpis = [['Triagem pendente', summary.triage || 0, 'Demandas ainda sem análise técnica', 'primary', 'ki-questionnaire-tablet'], ['Em análise', summary.analysis || 0, 'Requisitos em elaboração', 'warning', 'ki-notepad-edit'], ['Em desenvolvimento', summary.delivery || 0, 'User Stories em andamento', 'success', 'ki-rocket'], ['Atenção necessária', summary.attention || 0, 'Impedimentos ou decisões prioritárias', 'danger', 'ki-notification-status'], ['Sem User Story', unlinked, 'Sem destino técnico definido', 'info', 'ki-route'], ['Sem referência técnica', withoutCreator, 'WP em andamento sem criador retornado', 'secondary', 'ki-people']];
            document.getElementById('flow-kpis').innerHTML = kpis.map(([title, value, subtitle, color, icon]) => `<div class="col-md-6 col-xl-4"><div class="card flow-kpi border border-${color} border-opacity-25"><div class="card-body d-flex align-items-center gap-4"><span class="symbol symbol-50px"><span class="symbol-label bg-light-${color}"><i class="ki-duotone ${icon} fs-2 text-${color}"><span class="path1"></span><span class="path2"></span></i></span></span><div><div class="flow-kpi-value fw-bold text-${color}">${value}</div><div class="fw-bold mt-2">${title}</div><div class="text-gray-500 fs-7">${subtitle}</div></div></div></div></div>`).join('');
            const total = Math.max(items.length, 1);
            document.getElementById('flow-stages').innerHTML = stages.map(stage => { const amount = items.filter(item => item.stage === stage.key).length; return `<a href="${detailsUrl}?${new URLSearchParams({ stage: stage.key }).toString()}" class="flow-item d-block py-4 text-decoration-none"><div class="d-flex align-items-center justify-content-between mb-2"><span class="fw-bold text-gray-800">${stage.label}</span><span class="badge badge-light-${stage.color}">${amount}</span></div><div class="flow-bar"><span class="bg-${stage.color}" style="width:${(amount / total) * 100}%"></span></div></a>`; }).join('');
            const capacity = Object.values(openItems.filter(item => item.stage === 'delivery').reduce((result, item) => { const name = item.workPackageCreator || 'Não informado'; const entry = result[name] || { name, amount: 0 }; entry.amount += 1; result[name] = entry; return result; }, {})).sort((a, b) => b.amount - a.amount || a.name.localeCompare(b.name));
            const maxCapacity = Math.max(...capacity.map(entry => entry.amount), 1);
            document.getElementById('flow-capacity').innerHTML = capacity.length ? capacity.slice(0, 8).map(entry => `<div class="flow-item py-4"><div class="d-flex align-items-center justify-content-between mb-2"><span class="fw-bold text-gray-800">${escapeHtml(entry.name)}</span><span class="badge badge-light-success">${entry.amount} WP(s)</span></div><div class="flow-bar"><span class="bg-success" style="width:${(entry.amount / maxCapacity) * 100}%"></span></div></div>`).join('') : '<div class="text-center text-gray-500 py-8">Não há User Stories em desenvolvimento na projeção atual.</div>';
            const blockers = openItems.filter(item => item.stage === 'attention' || item.priority === 'Crítica' || item.priority === 'Alta' || item.isGlpiLinkPending).sort((a, b) => (b.priority === 'Crítica') - (a.priority === 'Crítica') || (b.isAtRisk === true) - (a.isAtRisk === true) || (b.daysOpen || 0) - (a.daysOpen || 0)).slice(0, 15);
            document.getElementById('flow-blockers').innerHTML = blockers.length ? blockers.map(item => { const stage = stages.find(stage => stage.key === item.stage) || stages[0]; const workspace = item.workspaceId ? `/ServiceDesk/Workspace/${item.workspaceId}?returnSource=flow` : `${detailsUrl}?${new URLSearchParams({ client: item.clientEntityName || 'Cliente não informado' }).toString()}`; return `<tr><td><div class="fw-bold">#${item.glpiTicketId}</div><div class="text-gray-600 text-truncate" style="max-width:280px">${escapeHtml(item.subject)}</div><div class="text-gray-500 fs-8">${item.daysOpen || 0} dias em aberto</div></td><td><span class="badge badge-light-${stage.color}">${stage.label}</span><div class="mt-1"><span class="badge badge-light-${priorityClass(item.priority)}">${escapeHtml(item.priority)}</span></div></td><td>${item.workPackageId ? `<div class="fw-bold">WP #${item.workPackageId}</div><div class="text-gray-500 fs-8">${escapeHtml(item.workPackageCreator || 'Criador não informado')}</div>` : '<span class="text-gray-500">Sem User Story</span>'}</td><td class="text-gray-600" style="max-width:300px">${escapeHtml(item.priorityReason || 'Verificar o andamento da demanda.')}</td><td class="text-end"><a href="${workspace}" class="btn btn-sm btn-light-primary">Tratar</a></td></tr>`; }).join('') : '<tr><td colspan="5" class="text-center text-gray-500 py-8">Não há impedimentos ou decisões prioritárias neste momento.</td></tr>';
        }

        refreshButton.addEventListener('click', async () => { refreshButton.disabled = true; try { await fetch(refreshUrl, { method: 'POST' }); await loadFlow(); } finally { refreshButton.disabled = false; } });
        loadFlow();
    })();
</script>
