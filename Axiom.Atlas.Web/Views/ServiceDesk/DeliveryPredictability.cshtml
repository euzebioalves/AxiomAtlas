@{
    ViewData["Title"] = "Entregas e previsibilidade";
}

<div class="app-content flex-column-fluid" id="kt_app_content"><div class="app-container container-fluid"><div class="d-flex flex-column gap-7">
    <div class="card delivery-hero"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-5 py-7"><div><span class="badge badge-light-primary mb-3">Visão gerencial</span><h1 class="fs-2x fw-bold mb-2">Entregas e previsibilidade</h1><p class="text-gray-600 fw-semibold mb-0">Acompanhe a cobertura técnica, o status das entregas e o esforço registrado nas demandas da carteira.</p><p id="delivery-synchronization" class="text-gray-500 fs-7 mt-3 mb-0"></p></div><div class="d-flex flex-wrap gap-3"><button type="button" class="btn btn-light-primary management-help-trigger" data-management-help-key="delivery" data-management-help-title="Como interpretar as entregas"><span class="management-help-question me-2">?</span>Como interpretar</button><a asp-action="Dashboard" class="btn btn-light-primary">Painel executivo</a><button id="delivery-refresh" type="button" class="btn btn-primary">Atualizar fontes</button></div></div></div>
    <div id="delivery-error" class="alert alert-danger d-none mb-0"><span id="delivery-error-message"></span></div>
    <div id="delivery-loading" class="card"><div class="card-body d-flex align-items-center justify-content-center gap-3 py-12"><span class="spinner-border text-primary"></span><span class="fw-semibold text-gray-600">Consolidando as entregas...</span></div></div>
    <div id="delivery-content" class="d-none d-flex flex-column gap-7">
        <div class="row g-5" id="delivery-kpis"></div>
        <div class="row g-7"><div class="col-xl-6"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Funil de entrega <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="delivery" data-management-help-title="Funil de entrega"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Da necessidade registrada ao estado atual da entrega.</span></div></div><div class="card-body pt-2" id="delivery-funnel"></div></div></div><div class="col-xl-6"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Previsibilidade disponível <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="predictability" data-management-help-title="Previsibilidade disponível"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Esforço registrado nas WPs vinculadas à carteira.</span></div></div><div class="card-body pt-2" id="delivery-effort"></div></div></div></div>
        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Demandas com maior esforço registrado</h2><span class="text-gray-500 fw-semibold fs-7">Horas apontadas no Axiom Atlas para as Work Packages vinculadas aos chamados.</span></div></div><div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0"><thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase"><th>Demanda</th><th>Cliente</th><th>Status da entrega</th><th class="text-end">Horas registradas</th><th class="text-end">Pendentes de sincronização</th><th class="text-end">Ação</th></tr></thead><tbody id="delivery-ranking"></tbody></table></div></div></div>
    </div>
</div></div></div>

<partial name="_ManagementDashboardHelp" />

<style>
    .delivery-hero { background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), .10), rgba(var(--bs-success-rgb), .06)); }
    .delivery-kpi { min-height: 150px; } .delivery-kpi-value { font-size: 2rem; line-height: 1; }
    .delivery-item + .delivery-item { border-top: 1px dashed var(--bs-border-color); }
    .delivery-bar { height: 9px; border-radius: 99px; background: var(--bs-gray-200); overflow: hidden; } .delivery-bar > span { display: block; height: 100%; border-radius: inherit; }
    [data-bs-theme="dark"] .delivery-bar { background: #242838; }
</style>

<script>
    (() => {
        const loading = document.getElementById('delivery-loading'), content = document.getElementById('delivery-content'), error = document.getElementById('delivery-error'), errorMessage = document.getElementById('delivery-error-message'), refreshButton = document.getElementById('delivery-refresh');
        const dataUrl = '@Url.Action("DashboardData", "ServiceDesk")', refreshUrl = '@Url.Action("RefreshKanban", "ServiceDesk")', detailsUrl = '@Url.Action("DashboardDetails", "ServiceDesk")';
        const escapeHtml = value => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        const formatDateTime = value => value ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(value)) : 'Ainda não sincronizada';
        const formatInterval = seconds => seconds >= 60 ? `${Math.round(seconds / 60)} min` : `${seconds} s`;
        const formatHours = hours => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(hours || 0);
        const stage = item => ({ attention: ['Atenção necessária', 'danger'], triage: ['Triagem GLPI', 'primary'], analysis: ['Análise de requisitos', 'warning'], delivery: ['Em desenvolvimento', 'success'], completed: ['Concluída', 'info'] }[item.stage] || ['Não informado', 'secondary']);

        async function loadDelivery() { loading.classList.remove('d-none'); content.classList.add('d-none'); error.classList.add('d-none'); try { const response = await fetch(dataUrl); const raw = await response.text(); let payload; try { payload = raw ? JSON.parse(raw) : null; } catch { throw new Error(`A consulta retornou uma resposta inválida (HTTP ${response.status}).`); } if (!response.ok || !payload) throw new Error(payload?.message || payload?.detail || `Não foi possível carregar as entregas (HTTP ${response.status}).`); renderDelivery(payload); content.classList.remove('d-none'); } catch (exception) { errorMessage.textContent = exception.message; error.classList.remove('d-none'); } finally { loading.classList.add('d-none'); } }

        function renderDelivery(payload) {
            const items = payload.items || [], summary = payload.summary || {}, openItems = items.filter(item => item.stage !== 'completed'), withWp = items.filter(item => item.workPackageId), completed = items.filter(item => item.stage === 'completed'), completionRate = items.length ? Math.round((completed.length / items.length) * 100) : 0, coverageRate = items.length ? Math.round((withWp.length / items.length) * 100) : 0;
            document.getElementById('delivery-synchronization').textContent = payload.synchronizationPending ? 'Uma atualização está em andamento. As entregas serão reconciliadas em segundo plano.' : `Projeção local atualizada em ${formatDateTime(payload.lastSynchronizedAt)}. Fontes reconciliadas a cada ${formatInterval(payload.synchronizationIntervalSeconds || 300)}.`;
            const kpis = [['Cobertura técnica', `${coverageRate}%`, `${withWp.length} demanda(s) com Work Package`, 'primary'], ['Conclusão atual', `${completionRate}%`, `${completed.length} demanda(s) concluídas`, 'success'], ['Horas registradas', `${formatHours(summary.totalLoggedHours)} h`, `${summary.workPackagesWithLoggedHours || 0} WP(s) com esforço apontado`, 'info'], ['Horas pendentes de envio', `${formatHours(summary.pendingSyncHours)} h`, 'Entradas ainda não sincronizadas com OpenProject', 'warning']];
            document.getElementById('delivery-kpis').innerHTML = kpis.map(([title, value, subtitle, color]) => `<div class="col-md-6 col-xl-3"><div class="card delivery-kpi border border-${color} border-opacity-25"><div class="card-body"><div class="delivery-kpi-value fw-bold text-${color}">${value}</div><div class="fw-bold mt-3">${title}</div><div class="text-gray-500 fs-7">${subtitle}</div></div></div></div>`).join('');
            const funnel = [{ label: 'Demandas na carteira', color: 'primary', amount: items.length }, { label: 'Com Work Package', color: 'info', amount: withWp.length }, { label: 'Em desenvolvimento', color: 'success', amount: items.filter(item => item.stage === 'delivery').length }, { label: 'Concluídas', color: 'success', amount: completed.length }, { label: 'Vínculos pendentes', color: 'danger', amount: summary.pendingGlpiLinks || 0 }], total = Math.max(items.length, 1);
            document.getElementById('delivery-funnel').innerHTML = funnel.map(entry => `<div class="delivery-item py-4"><div class="d-flex align-items-center justify-content-between mb-2"><span class="fw-bold text-gray-800">${entry.label}</span><span class="badge badge-light-${entry.color}">${entry.amount}</span></div><div class="delivery-bar"><span class="bg-${entry.color}" style="width:${Math.min(100, (entry.amount / total) * 100)}%"></span></div></div>`).join('');
            const effort = [{ label: 'Horas sincronizadas', color: 'success', amount: summary.totalLoggedHours - summary.pendingSyncHours }, { label: 'Horas pendentes de envio', color: 'warning', amount: summary.pendingSyncHours }, { label: 'WPs com apontamento', color: 'primary', amount: summary.workPackagesWithLoggedHours || 0 }, { label: 'Dados necessários para previsão', color: 'secondary', amount: 'Estimativa e data de conclusão' }];
            document.getElementById('delivery-effort').innerHTML = effort.map(entry => `<div class="delivery-item py-4"><div class="d-flex align-items-center justify-content-between"><span class="fw-bold text-gray-800">${entry.label}</span><span class="badge badge-light-${entry.color}">${typeof entry.amount === 'number' ? formatHours(entry.amount) : entry.amount}${entry.label.includes('Horas') ? ' h' : ''}</span></div></div>`).join('');
            const ranking = [...items].filter(item => item.loggedHours > 0 || item.pendingSyncHours > 0).sort((a, b) => (b.loggedHours || 0) - (a.loggedHours || 0)).slice(0, 20);
            document.getElementById('delivery-ranking').innerHTML = ranking.length ? ranking.map(item => { const [label, color] = stage(item), action = item.workspaceId ? `/ServiceDesk/Workspace/${item.workspaceId}?returnSource=delivery` : `${detailsUrl}?${new URLSearchParams({ client: item.clientEntityName || 'Cliente não informado' }).toString()}`; return `<tr><td><div class="fw-bold">#${item.glpiTicketId}</div><div class="text-gray-600 text-truncate" style="max-width:280px">${escapeHtml(item.subject)}</div><div class="text-gray-500 fs-8">WP #${item.workPackageId}</div></td><td class="fw-semibold">${escapeHtml(item.clientEntityName || 'Não informado')}</td><td><span class="badge badge-light-${color}">${label}</span></td><td class="text-end fw-bold">${formatHours(item.loggedHours)} h</td><td class="text-end"><span class="badge badge-light-warning">${formatHours(item.pendingSyncHours)} h</span></td><td class="text-end"><a href="${action}" class="btn btn-sm btn-light-primary">Tratar</a></td></tr>`; }).join('') : '<tr><td colspan="6" class="text-center text-gray-500 py-8">Ainda não há horas registradas para Work Packages vinculadas às demandas.</td></tr>';
        }
        refreshButton.addEventListener('click', async () => { refreshButton.disabled = true; try { await fetch(refreshUrl, { method: 'POST' }); await loadDelivery(); } finally { refreshButton.disabled = false; } });
        loadDelivery();
    })();
</script>
