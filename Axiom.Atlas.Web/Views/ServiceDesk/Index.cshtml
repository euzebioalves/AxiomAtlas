@{
    ViewData["Title"] = "Demandas GLPI";
}

<style>
    html.service-desk-loading, body.service-desk-loading { overflow: hidden !important; }
    .service-desk-loader-overlay { position: fixed; inset: 0; z-index: 1080; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; background: rgba(var(--bs-body-bg-rgb), .82); backdrop-filter: blur(2px); }
    .service-desk-loader-panel { width: min(100%, 28rem); padding: 2.5rem; text-align: center; background: var(--bs-body-bg); border: 1px solid var(--bs-border-color); border-radius: .75rem; box-shadow: var(--bs-box-shadow-lg); }
    .service-desk-row-highlight > td { background-color: var(--bs-primary-light) !important; transition: background-color .6s ease; }
    .service-desk-row-highlight > td:first-child { box-shadow: inset 3px 0 0 var(--bs-primary); }
    .queue-kpi { appearance: none; border: 1px solid var(--bs-border-color); border-radius: .625rem; background: var(--bs-body-bg); color: var(--bs-body-color); display: flex; align-items: center; gap: .8rem; padding: .85rem 1rem; text-align: left; transition: .15s ease; }
    .queue-kpi:hover { border-color: var(--bs-primary); background: var(--bs-primary-light); transform: translateY(-1px); }
    .queue-kpi b, .queue-kpi small { display: block; } .queue-kpi b { font-size: 1.25rem; } .queue-kpi small { color: var(--bs-gray-600); font-size: .75rem; font-weight: 600; }
    html[data-bs-theme="dark"] .queue-kpi { background: #151822; border-color: #2b2f3e; } html[data-bs-theme="dark"] .queue-kpi:hover { background: #1a2130; }
    [data-service-desk-column].queue-column-hidden { display: none !important; }
</style>

<div id="improvementsLoader" class="service-desk-loader-overlay" aria-live="polite" aria-busy="true"><div class="service-desk-loader-panel"><span class="spinner-border text-primary mb-4" role="status"></span><div id="improvementsLoaderMessage" class="fw-semibold text-gray-700">Consultando solicitações de melhoria...</div><div id="improvementsLoaderDetail" class="text-muted fs-7 mt-1">Isso pode levar alguns instantes.</div></div></div>

<div class="app-content flex-column-fluid"><div class="app-container container-fluid">
    <div class="card card-flush mb-7"><div class="card-body p-9 d-flex flex-column flex-lg-row align-items-lg-center gap-5"><div class="flex-grow-1"><div class="badge badge-light-primary mb-2">Service Desk</div><h1 class="fs-2 fw-bold mb-2">Solicitações de melhoria</h1><div class="text-muted">Uma fila de decisão que conecta o chamado do GLPI à execução técnica no OpenProject.</div></div><a asp-action="Dashboard" class="btn btn-light-primary"><i class="ki-duotone ki-chart-line-up fs-2"><span class="path1"></span><span class="path2"></span></i>Visão gerencial</a></div></div>
    <div class="card card-flush position-relative"><div id="improvementResults" aria-busy="true"></div></div>
</div></div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="queuePreview" aria-labelledby="queuePreviewTitle"><div class="offcanvas-header"><div><h3 id="queuePreviewTitle" class="mb-1">Prévia da demanda</h3><div class="text-muted fs-7">Dados da projeção local conciliada</div></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body" id="queuePreviewContent"></div></div>

@section Scripts {
<script>
(() => {
    const results = document.getElementById('improvementResults'), loader = document.getElementById('improvementsLoader');
    const loaderMessage = document.getElementById('improvementsLoaderMessage'), loaderDetail = document.getElementById('improvementsLoaderDetail');
    const filterStorageKey = 'axiomAtlas.serviceDesk.queue.filters.v1', columnsStorageKey = 'axiomAtlas.serviceDesk.queue.columns.v1';
    let activeListRequest, latestListRequest = 0, revalidationTimer, isNavigatingToWorkspace = false, searchTimer;
    const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;' })[c]);
    const defaults = () => ({ page: 1, pageSize: 25, status: 'not_solved', search: '', client: '', stage: '', priority: '', workPackage: '', onlyRisk: false, onlyMine: false, sort: 'recommended', highlight: null });
    const parseState = () => {
        const params = new URLSearchParams(window.location.search), state = defaults();
        Object.keys(state).forEach(key => { if (params.has(key)) state[key] = params.get(key); });
        state.page = Math.max(1, Number.parseInt(state.page, 10) || 1); state.pageSize = [10,25,50,100].includes(Number.parseInt(state.pageSize,10)) ? Number.parseInt(state.pageSize,10) : 25;
        state.onlyRisk = state.onlyRisk === true || state.onlyRisk === 'true'; state.onlyMine = state.onlyMine === true || state.onlyMine === 'true';
        if (!window.location.search) { try { return { ...state, ...JSON.parse(localStorage.getItem(filterStorageKey) || '{}'), page: 1 }; } catch { return state; } }
        return state;
    };
    const toParams = state => { const p = new URLSearchParams(); Object.entries(state).forEach(([key, value]) => { if (value !== '' && value !== false && value != null && key !== 'highlight') p.set(key, value); }); return p; };
    const setLoading = loading => { loader.classList.toggle('d-none', !loading); document.documentElement.classList.toggle('service-desk-loading', loading); document.body.classList.toggle('service-desk-loading', loading); results.setAttribute('aria-busy', String(loading)); };
    const renderError = (message, detail) => results.innerHTML = `<div class="card-body"><div class="alert alert-danger mb-0"><div class="fw-bold">${escapeHtml(message)}</div>${detail ? `<div class="fs-7 mt-2">${escapeHtml(detail)}</div>` : ''}</div></div>`;
    const highlightTicket = ticketId => { if (!ticketId) return; const row = results.querySelector(`[data-ticket-id="${ticketId}"]`); if (!row) return; row.classList.add('service-desk-row-highlight'); row.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(() => row.classList.remove('service-desk-row-highlight'), 5000); };
    const getHiddenColumns = () => { try { return JSON.parse(localStorage.getItem(columnsStorageKey) || '[]'); } catch { return []; } };
    const applyColumnPreferences = () => { const hidden = new Set(getHiddenColumns()); results.querySelectorAll('[data-service-desk-column]').forEach(node => node.classList.toggle('queue-column-hidden', hidden.has(node.dataset.serviceDeskColumn))); results.querySelectorAll('[data-queue-column-toggle]').forEach(input => input.checked = !hidden.has(input.dataset.queueColumnToggle)); };
    const updateSelection = () => { const selected = results.querySelectorAll('[data-queue-ticket-select]:checked').length, toolbar = results.querySelector('#queueBulkToolbar'); toolbar?.classList.toggle('d-none', !selected); toolbar?.querySelector('[data-queue-selected-count]')?.replaceChildren(String(selected)); const all = results.querySelector('#selectAllQueueTickets'); if (all) { const boxes = results.querySelectorAll('[data-queue-ticket-select]'); all.checked = boxes.length > 0 && selected === boxes.length; all.indeterminate = selected > 0 && selected < boxes.length; } };
    async function loadPage(state, updateUrl = true, forceRefresh = false, silent = false) {
        if (isNavigatingToWorkspace) return; activeListRequest?.abort(); const controller = new AbortController(), requestId = ++latestListRequest; activeListRequest = controller;
        if (!silent) setLoading(true);
        try {
            const params = toParams(state); params.set('refresh', String(forceRefresh));
            const response = await fetch(`/ServiceDesk/List?${params}`, { signal: controller.signal });
            if (!response.ok) { const error = await response.json().catch(() => ({})); throw Object.assign(new Error(error.message || 'Não foi possível consultar a fila.'), { detail: error.detail }); }
            const markup = await response.text(); if (requestId !== latestListRequest || isNavigatingToWorkspace) return;
            results.innerHTML = markup; window.KTComponents?.init(); applyColumnPreferences(); highlightTicket(state.highlight);
            if (updateUrl) window.history.pushState({}, '', `${location.pathname}?${toParams(state)}`);
            clearTimeout(revalidationTimer); if (results.querySelector('[data-synchronization-pending="true"]')) revalidationTimer = setTimeout(() => loadPage(state, false, false, true), 5000);
        } catch (error) { if (error.name !== 'AbortError' && requestId === latestListRequest) renderError(error.message, error.detail); }
        finally { if (!silent && requestId === latestListRequest) setLoading(false); }
    }
    const currentStateWith = change => ({ ...parseState(), ...change });
    const importTicketForTreatment = async ticketId => {
        if (isNavigatingToWorkspace) return; isNavigatingToWorkspace = true; setLoading(true); loaderMessage.textContent = 'Preparando a tela de tratamento do chamado...'; loaderDetail.textContent = 'Consultando os dados necessários no GLPI e no OpenProject.';
        try { const response = await fetch('/ServiceDesk/Import', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({query:ticketId}) }); const data = await response.json(); if (!response.ok) throw new Error(data.message || 'Não foi possível importar o chamado.'); const state = parseState(); location.assign(`/ServiceDesk/Workspace/${data.id}?returnPage=${state.page}&returnPageSize=${state.pageSize}&returnStatus=${encodeURIComponent(state.status)}`); } catch (error) { isNavigatingToWorkspace=false; setLoading(false); Swal.fire({icon:'error', text:error.message}); }
    };
    const showPreview = row => { const d=row.dataset, wp=d.wp ? `<div class="d-flex flex-column gap-1"><span class="fw-bold">WP #${escapeHtml(d.wp)}</span><span class="text-muted">${escapeHtml(d.wpStatus || 'Status não informado')}</span></div>` : '<span class="badge badge-light-warning">Sem Work Package vinculada</span>'; document.getElementById('queuePreviewContent').innerHTML = `<div class="d-flex flex-column gap-5"><div><div class="d-flex justify-content-between gap-3"><span class="badge badge-light-primary">Chamado #${escapeHtml(row.dataset.ticketId)}</span><span class="badge badge-light-${d.priority === 'Crítica' ? 'danger' : d.priority === 'Alta' ? 'warning' : 'primary'}">${escapeHtml(d.priority)}</span></div><h4 class="mt-3 mb-1">${escapeHtml(d.subject)}</h4><div class="text-muted">${escapeHtml(d.client || 'Cliente não identificado')}</div></div><div class="separator"></div><div class="row g-4"><div class="col-6"><div class="text-muted fs-8">ETAPA</div><div class="fw-bold">${escapeHtml(d.stage)}</div></div><div class="col-6"><div class="text-muted fs-8">RESPONSÁVEL</div><div class="fw-bold">${escapeHtml(d.assignee || 'Não atribuído')}</div></div><div class="col-6"><div class="text-muted fs-8">IDADE</div><div class="fw-bold">${escapeHtml(d.age)} dia(s)</div></div><div class="col-6"><div class="text-muted fs-8">STATUS GLPI</div><div class="fw-bold">${escapeHtml(d.status)}</div></div></div><div><div class="text-muted fs-8 mb-1">WORK PACKAGE</div>${wp}</div><div class="alert alert-light-primary mb-0"><div class="fw-bold mb-1">Por que esta é a prioridade?</div><div class="fs-7">${escapeHtml(d.reason)}</div></div>${d.workspaceId ? `<a class="btn btn-primary" href="/ServiceDesk/Workspace/${escapeHtml(d.workspaceId)}">Abrir área de trabalho</a>` : `<button class="btn btn-primary" data-treat-ticket="${escapeHtml(row.dataset.ticketId)}">Preparar tratamento</button>`}</div>`; bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('queuePreview')).show(); };
    document.addEventListener('click', event => {
        const page = event.target.closest('[data-improvements-page]'); if (page && !page.disabled) { event.preventDefault(); loadPage(currentStateWith({page:Number(page.dataset.improvementsPage)})); return; }
        if (event.target.closest('#refreshImprovements')) { event.preventDefault(); loadPage(parseState(), false, true); return; }
        const quick = event.target.closest('[data-queue-quick-filter]'); if (quick) { const key=quick.dataset.queueQuickFilter; const next = key === 'without' ? {workPackage:'without',onlyRisk:false,onlyMine:false} : key === 'risk' ? {onlyRisk:true,workPackage:'',onlyMine:false} : key === 'pending-link' ? {workPackage:'pending-link',onlyRisk:false,onlyMine:false} : key === 'mine' ? {onlyMine:true,onlyRisk:false,workPackage:''} : {onlyMine:false,onlyRisk:false,workPackage:''}; loadPage(currentStateWith({...next,page:1})); return; }
        const treatment = event.target.closest('[data-treat-ticket]'); if (treatment) { event.preventDefault(); importTicketForTreatment(treatment.dataset.treatTicket); return; }
        const preview = event.target.closest('[data-preview-queue-ticket]'); if (preview) { showPreview(preview.closest('tr')); return; }
        const exporter = event.target.closest('[data-queue-export]'); if (exporter) { event.preventDefault(); const state=parseState(), names={pdf:'ExportPdf',excel:'ExportExcel',csv:'ExportCsv'}; location.assign(`/ServiceDesk/${names[exporter.dataset.queueExport]}?${toParams({...state,page:1,pageSize:100})}`); return; }
        if (event.target.closest('#saveQueueView')) { localStorage.setItem(filterStorageKey, JSON.stringify({...parseState(),page:1,highlight:null})); Swal.fire({icon:'success',text:'Visão salva neste navegador.',timer:1400,showConfirmButton:false}); return; }
        if (event.target.closest('#clearQueueView')) { localStorage.removeItem(filterStorageKey); loadPage(defaults()); return; }
        if (event.target.closest('#applyBulkUpdate')) { applyBulkUpdate(); }
        if (event.target.closest('#prepareBulkWorkspaces')) { prepareBulkWorkspaces(); }
    });
    document.addEventListener('input', event => { if (event.target.id === 'improvementsSearch') { clearTimeout(searchTimer); searchTimer = setTimeout(() => loadPage(currentStateWith({search:event.target.value,page:1})), 350); } });
    document.addEventListener('change', event => {
        if (event.target.matches('[data-queue-filter]')) { const key=event.target.dataset.queueFilter, value=event.target.type === 'checkbox' ? event.target.checked : event.target.value; loadPage(currentStateWith({[key]:value,page:1})); return; }
        if (event.target.matches('[data-improvements-page-size]')) { loadPage(currentStateWith({pageSize:Number(event.target.value),page:1})); return; }
        if (event.target.matches('[data-queue-column-toggle]')) { const hidden = new Set(getHiddenColumns()); event.target.checked ? hidden.delete(event.target.dataset.queueColumnToggle) : hidden.add(event.target.dataset.queueColumnToggle); localStorage.setItem(columnsStorageKey, JSON.stringify([...hidden])); applyColumnPreferences(); return; }
        if (event.target.matches('#selectAllQueueTickets')) { results.querySelectorAll('[data-queue-ticket-select]').forEach(box => box.checked = event.target.checked); updateSelection(); return; }
        if (event.target.matches('[data-queue-ticket-select]')) updateSelection();
    });
    async function applyBulkUpdate() { const ids=[...results.querySelectorAll('[data-queue-ticket-select]:checked')].map(box => Number(box.value)); if (!ids.length) return; const assignee=results.querySelector('#bulkAssignee').value; const body={ticketIds:ids,assignedUserId:assignee || null,priority:results.querySelector('#bulkPriority').value || null,stage:results.querySelector('#bulkStage').value || null,classification:results.querySelector('#bulkClassification').value || null}; if (!body.assignedUserId && !body.priority && !body.stage && !body.classification) { Swal.fire({icon:'info',text:'Escolha ao menos uma alteração para aplicar.'}); return; } const confirmation=await Swal.fire({icon:'question',title:'Aplicar alteração em massa?',text:`As alterações serão salvas no Atlas para ${ids.length} chamado(s).`,showCancelButton:true,confirmButtonText:'Aplicar',cancelButtonText:'Cancelar'}); if (!confirmation.isConfirmed) return; const response=await fetch('/ServiceDesk/BulkUpdate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); const payload=await response.json().catch(()=>({})); if (!response.ok) { Swal.fire({icon:'error',text:payload.message || 'Não foi possível aplicar as alterações.'}); return; } Swal.fire({icon:'success',text:payload.message,timer:1500,showConfirmButton:false}); loadPage(parseState(),false); }
    async function prepareBulkWorkspaces() { const ids=[...results.querySelectorAll('[data-queue-ticket-select]:checked')].map(box => Number(box.value)); if (!ids.length) return; if (ids.length > 20) { Swal.fire({icon:'info',text:'Selecione no máximo 20 chamados por vez.'}); return; } const confirmation=await Swal.fire({icon:'question',title:'Preparar áreas de trabalho?',html:`O Atlas consultará o GLPI e preparará <b>${ids.length}</b> área(s) de trabalho. Depois, cada uma poderá criar ou vincular sua Work Package.`,showCancelButton:true,confirmButtonText:'Preparar',cancelButtonText:'Cancelar'}); if (!confirmation.isConfirmed) return; const response=await fetch('/ServiceDesk/PrepareWorkspaces',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ticketIds:ids})}); const payload=await response.json().catch(()=>({})); if (!response.ok) { Swal.fire({icon:'error',text:payload.message || 'Não foi possível preparar as áreas.'}); return; } const first=payload.workspaces?.[0]?.id; await Swal.fire({icon:'success',title:'Áreas preparadas',text:payload.message,confirmButtonText:first ? 'Abrir primeira área' : 'Concluir',showCancelButton:!!first,cancelButtonText:'Concluir'}).then(result => { if (result.isConfirmed && first) location.assign(`/ServiceDesk/Workspace/${first}`); }); loadPage(parseState(),false); }
    window.addEventListener('popstate', () => loadPage(parseState(), false)); window.addEventListener('pageshow', () => setLoading(false)); loadPage(parseState(), false, true);
})();
</script>
}
