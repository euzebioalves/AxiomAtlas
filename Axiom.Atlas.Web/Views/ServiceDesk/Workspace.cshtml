@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Text.RegularExpressions
@model Axiom.Atlas.Application.DTOs.ServiceDesk.GlpiTicketWorkspaceDto
@{
    ViewData["Title"] = $"GLPI #{Model.GlpiTicketId}";
    using var ticket = JsonDocument.Parse(Model.TicketPayloadJson);
    var payload = ticket.RootElement;

    string Text(string name) => payload.TryGetProperty(name, out var value) ? value.ToString() : string.Empty;
    string FormatGlpiDate(string value, bool includeTime = false) => DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out var date)
        ? date.ToString(includeTime ? "dd/MM/yyyy HH:mm" : "dd/MM/yyyy", CultureInfo.GetCultureInfo("pt-BR"))
        : value;

    var rawDescription = Text("content");
    var description = WebUtility.HtmlDecode(rawDescription);

    // Preserve the rich GLPI content while isolating executable markup and source theme styling.
    description = Regex.Replace(description, @"<(script|style|iframe|object|embed)[^>]*>.*?</\1>", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Singleline);
    description = Regex.Replace(description, @"\son\w+\s*=\s*[^\s>]+", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Singleline);
    description = Regex.Replace(description, @"javascript\s*:", string.Empty, RegexOptions.IgnoreCase);
    description = Regex.Replace(description, @"(?i)(background(?:-color)?|color|font-family)\s*:\s*[^;""']+;?", string.Empty);

    var attachmentProxyBaseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/ServiceDesk/Attachment/{Model.Id}?documentId=";
    description = Regex.Replace(description, @"(?<attribute>src|href)\s*=\s*(?<quote>[""'])(?<url>/front/document\.send\.php\?[^""']*docid=(?<id>\d+)[^""']*)\k<quote>", match =>
        $"{match.Groups["attribute"].Value}={match.Groups["quote"].Value}{attachmentProxyBaseUrl}{match.Groups["id"].Value}{match.Groups["quote"].Value}", RegexOptions.IgnoreCase);

    var glpiBaseUrl = "https://servicedesk.pontoid.com.br";
    if (payload.TryGetProperty("links", out var ticketLinks) && ticketLinks.ValueKind == JsonValueKind.Array)
    {
        var firstLink = ticketLinks.EnumerateArray().FirstOrDefault(x => x.TryGetProperty("href", out _));
        if (firstLink.ValueKind != JsonValueKind.Undefined && Uri.TryCreate(firstLink.GetProperty("href").GetString(), UriKind.Absolute, out var uri))
            glpiBaseUrl = uri.GetLeftPart(UriPartial.Authority);
    }

    var glpiTicketUrl = $"{glpiBaseUrl.TrimEnd('/')}/front/ticket.form.php?id={Model.GlpiTicketId}";

    var descriptionDocument = $"<!doctype html><html><head><base href='{glpiBaseUrl}/' target='_blank'><style>html,body{{background:#1e1e2d!important;color:#d8dbe8!important}}body{{margin:0;padding:1rem;font-family:Inter,Arial,sans-serif;line-height:1.65;overflow-wrap:anywhere}}body *{{background:transparent!important;color:#d8dbe8!important;border-color:#393945!important}}img{{max-width:100%!important;height:auto!important;border-radius:.45rem;cursor:zoom-in}}table{{max-width:100%!important;border-collapse:collapse}}td,th{{padding:.35rem}}a{{color:#50cdff!important}}hr{{border-color:#393945}}</style></head><body>{description}</body></html>";
    var status = Text("status");
    var statusDescription = status switch
    {
        "1" => "Novo",
        "2" => "Em atendimento",
        "3" => "Em atendimento planejado",
        "4" => "Pendente",
        "5" => "Solucionado",
        "6" => "Fechado",
        _ => string.IsNullOrWhiteSpace(status) ? "Não informado" : status
    };
    var createdAt = FormatGlpiDate(Text("date"));
    var updatedAt = FormatGlpiDate(Text("date_mod"));
    using var followUps = JsonDocument.Parse(Model.FollowUpsJson);
    using var attachments = JsonDocument.Parse(Model.AttachmentsJson);
    var followUpCount = followUps.RootElement.ValueKind == JsonValueKind.Array ? followUps.RootElement.GetArrayLength() : 0;
    var hasLinkedUserStory = Model.OpenProjectWorkPackageId.HasValue;
    var hasGlpiLink = !string.IsNullOrWhiteSpace(Model.GlpiDevOpsUrl);
    var linkSynchronization = Model.GlpiLinkSynchronization;
}

<div class="app-content flex-column-fluid">
    <div class="app-container container-fluid">
        <div class="d-flex flex-wrap flex-stack mb-7">
            <div>
                <div class="text-muted fs-7">
                    <a href="@glpiTicketUrl" target="_blank" rel="noopener noreferrer" class="text-muted text-hover-primary" title="Abrir chamado original no GLPI">
                        GLPI #@Model.GlpiTicketId <i class="ki-duotone ki-exit-up fs-7 ms-1"><span class="path1"></span><span class="path2"></span></i>
                    </a>
                    · @(Model.ClientEntityName ?? "Entidade não identificada")
                </div>
                <h1 class="fs-2 fw-bold">@Model.Subject</h1>
            </div>
            <a href="@(ViewData["ReturnUrl"] as string ?? Url.Action("Index"))" class="btn btn-light-primary">
                <i class="ki-duotone ki-arrow-left fs-2"></i>Voltar
            </a>
        </div>

        <div class="row g-7">
            <div class="col-xl-5">
                <div class="card card-flush h-100 service-desk-card">
                    <div class="card-header">
                        <div class="card-toolbar ticket-card-toolbar d-flex gap-2">
                            <span class="badge badge-light-primary">@(Model.ClientEntityName ?? "Entidade não identificada")</span>
                            <span class="badge badge-light-info">Status: @statusDescription</span>
                        </div>
                    </div>
                    <div class="card-body workspace-panel-body">
                        <div class="glpi-ticket-content mb-5">
                            <div class="ticket-content-header">
                                <div class="fw-bold">Descrição do chamado</div>
                                <div class="ticket-metadata">
                                    <span>Criado em <strong>@createdAt</strong></span>
                                    <span>Atualizado em <strong>@updatedAt</strong></span>
                                </div>
                            </div>
                            @if (string.IsNullOrWhiteSpace(description))
                            {
                                <div class="text-muted p-5">O GLPI não retornou uma descrição para este chamado.</div>
                            }
                            else
                            {
                                <div id="glpiTicketScroll" class="ticket-content-scroll scroll-y" data-kt-scroll="true" data-kt-scroll-activate="true" data-kt-scroll-height="540px" data-kt-scroll-save-state="false">
                                    <iframe class="glpi-ticket-frame" sandbox="allow-same-origin" srcdoc="@descriptionDocument" title="Conteúdo do chamado GLPI"></iframe>
                                </div>
                            }
                        </div>

                        <div class="fw-bold mb-3">Acompanhamentos</div>
                        @if (followUpCount == 0)
                        {
                            <div class="text-muted mb-5">Nenhum acompanhamento registrado.</div>
                        }
                        else
                        {
                            <div class="followup-list mb-5">
                                @foreach (var followUp in followUps.RootElement.EnumerateArray())
                                {
                                    var author = followUp.TryGetProperty("authorName", out var authorValue) ? authorValue.ToString() : $"Usuário GLPI #{followUp.GetProperty("users_id")}";
                                    var date = followUp.TryGetProperty("date", out var dateValue) ? FormatGlpiDate(dateValue.ToString(), includeTime: true) : "";
                                    var content = followUp.TryGetProperty("content", out var contentValue) ? Regex.Replace(WebUtility.HtmlDecode(contentValue.ToString()), "<[^>]+>", " ") : "";
                                    <div class="followup-bubble">
                                        <div class="fw-bold fs-8">@author <span class="text-muted fw-normal">· @date</span></div>
                                        <div>@content</div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="fw-bold mb-3">Anexos</div>
                        <div class="attachment-list">
                            @foreach (var attachment in attachments.RootElement.EnumerateArray())
                            {
                                var name = attachment.TryGetProperty("documentName", out var nameValue) ? nameValue.ToString() : $"Documento #{attachment.GetProperty("documents_id")}";
                                var documentId = attachment.GetProperty("documents_id").GetInt32();
                                var url = $"/ServiceDesk/Attachment/{Model.Id}?documentId={documentId}";
                                var isImage = name.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) || name.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);
                                if (isImage)
                                {
                                    <button type="button" class="attachment-thumb" data-image-url="@url" aria-label="Abrir imagem anexa">
                                        <img src="@url" alt="Imagem anexa" />
                                    </button>
                                }
                                else
                                {
                                    <a class="attachment-item" href="@url" target="_blank" rel="noopener" title="@name" aria-label="Abrir anexo"><i class="ki-duotone ki-file fs-3"></i></a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-7">
                <div class="card card-flush h-100 service-desk-card">
                    <div class="card-header">
                        <h3 class="card-title">User Story em Markdown</h3>
                        <div class="card-toolbar d-flex gap-3">
                            <button id="saveDraft" class="btn btn-light-primary">Salvar rascunho</button>
                            @if (!hasLinkedUserStory || !hasGlpiLink)
                            {
                                <button id="createUserStory" class="btn btn-primary">@(hasLinkedUserStory ? "Vincular ao GLPI" : "Criar e vincular")</button>
                            }
                        </div>
                    </div>
                    <div class="card-body workspace-panel-body">
                        @if (hasLinkedUserStory)
                        {
                            <div class="alert @(hasGlpiLink ? "alert-success" : "alert-warning") d-flex align-items-center mb-6">
                                <i class="ki-duotone @(hasGlpiLink ? "ki-check-circle" : "ki-information-5") fs-2x me-4"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">User Story #@Model.OpenProjectWorkPackageId criada no OpenProject</div>
                                    @if (hasGlpiLink)
                                    {
                                        <div class="fs-7">O vínculo ChamadoDevops também foi atualizado no GLPI.</div>
                                    }
                                    else if (linkSynchronization is not null)
                                    {
                                        <div class="fs-7">
                                            @if (linkSynchronization.Status is "Pending" or "Processing")
                                            {
                                                <span>O vínculo no GLPI está na fila de sincronização. Tentativa @linkSynchronization.AttemptCount de @linkSynchronization.MaxAttempts.</span>
                                            }
                                            else
                                            {
                                                <span>O vínculo no GLPI não foi concluído após @linkSynchronization.AttemptCount tentativa(s).</span>
                                                @if (!string.IsNullOrWhiteSpace(linkSynchronization.LastError))
                                                {
                                                    <span class="d-block mt-1">Detalhe: @linkSynchronization.LastError</span>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fs-7">O vínculo no GLPI está pendente. Use a ação de vínculo para colocá-lo novamente na fila.</div>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrWhiteSpace(Model.OpenProjectWorkPackageUrl))
                                    {
                                        <a href="@Model.OpenProjectWorkPackageUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light-primary">Abrir User Story</a>
                                    }
                                    <a href="/TimeEntries?workPackageId=@Model.OpenProjectWorkPackageId" class="btn btn-sm btn-primary">Lançar horas</a>
                                </div>
                            </div>
                        }
                        @if (!hasLinkedUserStory)
                        {
                            <div class="mb-6">
                                <label for="openProjectProject" class="form-label required">Projeto no OpenProject</label>
                                <select id="openProjectProject" class="form-select form-select-solid" data-control="select2" data-placeholder="Selecione o projeto para esta User Story">
                                    <option></option>
                                </select>
                                <div class="form-text">A User Story será criada com o tipo <strong>User Story</strong> no projeto selecionado.</div>
                            </div>
                        }
                        <div class="user-story-editor" aria-label="Editor da User Story">
                            <div class="user-story-editor-toolbar" id="storyEditorToolbar" role="toolbar" aria-label="Ferramentas de formatação">
                                <div class="user-story-editor-toolbar-group editor-block-format">
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-sm btn-light d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" title="Estilo do parágrafo">
                                            <span id="blockFormatLabel">Parágrafo</span><i class="fa-solid fa-chevron-down fs-8"></i>
                                        </button>
                                        <div class="dropdown-menu menu-sub-dropdown w-175px p-2">
                                            <button type="button" class="dropdown-item active" data-editor-action="paragraph" data-block-format-label="Parágrafo">Parágrafo</button>
                                            <button type="button" class="dropdown-item" data-editor-action="heading1" data-block-format-label="Título 1"><span class="fw-bold fs-6 me-3">H1</span>Título 1</button>
                                            <button type="button" class="dropdown-item" data-editor-action="heading2" data-block-format-label="Título 2"><span class="fw-bold fs-7 me-3">H2</span>Título 2</button>
                                            <button type="button" class="dropdown-item" data-editor-action="heading3" data-block-format-label="Título 3"><span class="fw-bold me-3">H3</span>Título 3</button>
                                            <button type="button" class="dropdown-item" data-editor-action="heading4" data-block-format-label="Título 4"><span class="fw-bold fs-8 me-3">H4</span>Título 4</button>
                                            <button type="button" class="dropdown-item" data-editor-action="heading5" data-block-format-label="Título 5"><span class="fw-bold fs-9 me-3">H5</span>Título 5</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="user-story-editor-toolbar-group">
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-icon btn-sm btn-light" data-bs-toggle="dropdown" aria-expanded="false" title="Formatação do texto"><i class="ki-duotone ki-text fs-3"></i></button>
                                        <div class="dropdown-menu menu-sub-dropdown w-180px p-2">
                                            <button type="button" class="dropdown-item" data-editor-action="bold"><i class="ki-duotone ki-text-bold fs-4 me-3"></i>Negrito <span class="ms-auto text-muted fs-8">Ctrl+B</span></button>
                                            <button type="button" class="dropdown-item" data-editor-action="italic"><i class="ki-duotone ki-text-italic fs-4 me-3"></i>Itálico <span class="ms-auto text-muted fs-8">Ctrl+I</span></button>
                                            <button type="button" class="dropdown-item" data-editor-action="strike"><i class="ki-duotone ki-text-strikethrough fs-4 me-3"></i>Tachado</button>
                                            <button type="button" class="dropdown-item" data-editor-action="highlight"><i class="ki-duotone ki-text-underline fs-4 me-3"></i>Sublinhado / destaque</button>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="inlineCode" title="Código em linha"><span class="font-monospace fw-bold fs-5">&lt;&gt;</span></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="codeBlock" title="Bloco de código"><i class="ki-duotone ki-code fs-3"></i></button>
                                </div>
                                <div class="user-story-editor-toolbar-group">
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="bulletList" title="Lista com marcadores"><i class="ki-duotone ki-menu fs-3"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="orderedList" title="Lista numerada"><i class="ki-duotone ki-notepad-bookmark fs-3"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="taskList" title="To-do list"><i class="ki-duotone ki-check-squared fs-3"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="quote" title="Citação"><i class="ki-duotone ki-message-text-2 fs-3"></i></button>
                                </div>
                                <div class="user-story-editor-toolbar-group">
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="link" title="Inserir link (Ctrl+K)"><i class="fa-solid fa-link fs-5"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="table" title="Inserir tabela"><i class="fa-solid fa-table fs-5"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="image" title="Inserir imagem por URL"><i class="ki-duotone ki-picture fs-3"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="uploadImage" title="Enviar imagem do computador"><i class="ki-duotone ki-file-up fs-3"></i></button>
                                    <button type="button" class="btn btn-icon btn-sm btn-light" data-editor-action="divider" title="Separador"><i class="ki-duotone ki-minus fs-3"></i></button>
                                </div>
                                <div class="ms-auto d-flex align-items-center gap-3">
                                    <button type="button" id="toggleMarkdownPreview" class="btn btn-sm btn-light-primary"><i class="ki-duotone ki-eye fs-4"></i><span>Visualizar</span></button>
                                </div>
                            </div>
                            <div class="user-story-editor-surface">
                                <textarea id="draft" class="user-story-editor-input font-monospace" rows="20" spellcheck="true" placeholder="# User Story&#10;&#10;## Contexto&#10;## Critérios de aceite">@Model.RequirementMarkdown</textarea>
                                <article id="draftPreview" class="user-story-editor-preview d-none" aria-live="polite"></article>
                            </div>
                            <input id="storyImageUpload" class="d-none" type="file" accept="image/png,image/jpeg,image/gif,image/webp" />
                            <div class="user-story-editor-footer">
                                <span><i class="ki-duotone ki-information-5 fs-6 me-1"></i>Markdown compatível com OpenProject. Cole uma imagem ou envie um arquivo de até 8 MB.</span>
                                <span id="draftCharacterCount">0 caracteres</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="attachmentPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0 justify-content-end"><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
            <div class="modal-body text-center pt-0"><img id="attachmentPreviewImage" class="mw-100 mh-600px" alt="Imagem anexa" /></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        window.scrollTo(0, 0);
        window.addEventListener('pageshow', () => window.scrollTo(0, 0));

        const modalElement = document.getElementById('attachmentPreviewModal');
        const previewImage = document.getElementById('attachmentPreviewImage');
        const openAttachmentPreview = (url) => {
            previewImage.src = url;
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        };

        const applyTicketTheme = (frame) => {
            const document = frame.contentDocument;
            if (!document) return;

            const isDark = frame.ownerDocument.documentElement.getAttribute('data-bs-theme') === 'dark';
            const palette = isDark
                ? { background: '#1e1e2d', text: '#d8dbe8', border: '#393945', link: '#50cdff' }
                : { background: '#f8f9fc', text: '#3f4254', border: '#e1e3ea', link: '#009ef7' };
            let style = document.getElementById('axiom-ticket-theme');
            if (!style) {
                style = document.createElement('style');
                style.id = 'axiom-ticket-theme';
                document.head.appendChild(style);
            }

            style.textContent = `html,body{background:${palette.background}!important;color:${palette.text}!important}body *{background:transparent!important;color:${palette.text}!important;border-color:${palette.border}!important}a{color:${palette.link}!important}`;
            frame.style.background = palette.background;
        };

        const draft = document.getElementById('draft');
        const draftPreview = document.getElementById('draftPreview');
        const draftCharacterCount = document.getElementById('draftCharacterCount');
        const previewToggle = document.getElementById('toggleMarkdownPreview');
        const storyImageUpload = document.getElementById('storyImageUpload');
        const blockFormatLabel = document.getElementById('blockFormatLabel');
        const maxWorkspaceImageBytes = 8 * 1024 * 1024;
        let isPreviewMode = false;

        const escapeHtml = value => String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');

        const safeUrl = (value, imageOnly = false) => {
            try {
                const url = new URL(value, window.location.origin);
                const allowedProtocols = imageOnly ? ['http:', 'https:'] : ['http:', 'https:', 'mailto:'];
                return allowedProtocols.includes(url.protocol) ? url.href : '';
            } catch {
                return '';
            }
        };

        const renderInlineMarkdown = value => {
            const protectedExternalLinks = [];
            const protectedResizedImages = [];
            let source = String(value ?? '').replace(
                /<img\s+src="([^"]+)"\s+alt="([^"]*)"\s+width="(\d{1,4})"\s*\/?>/gi,
                (_, url, alt, width) => {
                    const safeImageUrl = safeUrl(url, true);
                    const normalizedWidth = Math.min(2000, Math.max(80, Number(width)));
                    if (!safeImageUrl || !Number.isFinite(normalizedWidth)) return alt;
                    const token = `AXIOMRESIZEDIMAGE${protectedResizedImages.length}TOKEN`;
                    protectedResizedImages.push(`<img src="${escapeHtml(safeImageUrl)}" alt="${escapeHtml(alt)}" data-editor-image-url="${escapeHtml(safeImageUrl)}" width="${normalizedWidth}" loading="lazy" title="Clique para redimensionar">`);
                    return token;
                });
            source = source.replace(
                /<a\s+href="([^"]+)"\s+target="_blank"\s+rel="noopener noreferrer">([^<]*)<\/a>/gi,
                (_, url, label) => {
                    const safeLinkUrl = safeUrl(url);
                    if (!safeLinkUrl) return label;
                    const token = `AXIOMEXTERNALLINK${protectedExternalLinks.length}TOKEN`;
                    protectedExternalLinks.push(`<a href="${escapeHtml(safeLinkUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(label)}</a>`);
                    return token;
                });
            let html = escapeHtml(source);
            html = html.replace(/!\[([^\]]*)\]\(([^\s)]+)\)/g, (_, alt, url) => {
                const safeImageUrl = safeUrl(url, true);
                return safeImageUrl ? `<img src="${escapeHtml(safeImageUrl)}" alt="${alt}" data-editor-image-url="${escapeHtml(safeImageUrl)}" loading="lazy" title="Clique para redimensionar">` : alt;
            });
            html = html.replace(/\[([^\]]+)\]\(([^\s)]+)\)/g, (_, label, url) => {
                const safeLinkUrl = safeUrl(url);
                return safeLinkUrl ? `<a href="${escapeHtml(safeLinkUrl)}" target="_blank" rel="noopener noreferrer">${label}</a>` : label;
            });
            html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
            html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
            html = html.replace(/__([^_]+)__/g, '<strong>$1</strong>');
            html = html.replace(/~~([^~]+)~~/g, '<del>$1</del>');
            html = html.replace(/==([^=]+)==/g, '<mark>$1</mark>');
            html = html.replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
            html = html.replace(/(^|[^_])_([^_]+)_/g, '$1<em>$2</em>');
            html = html.replace(/AXIOMEXTERNALLINK(\d+)TOKEN/g, (_, index) => protectedExternalLinks[Number(index)] ?? '');
            html = html.replace(/AXIOMRESIZEDIMAGE(\d+)TOKEN/g, (_, index) => protectedResizedImages[Number(index)] ?? '');
            return html;
        };

        const renderMarkdownPreview = markdown => {
            const lines = String(markdown ?? '').replace(/\r\n/g, '\n').split('\n');
            const html = [];

            for (let index = 0; index < lines.length; index += 1) {
                const line = lines[index];
                if (line.startsWith('```')) {
                    const language = line.slice(3).trim();
                    const code = [];
                    while (++index < lines.length && !lines[index].startsWith('```')) code.push(lines[index]);
                    html.push(`<pre><code class="language-${escapeHtml(language)}">${escapeHtml(code.join('\n'))}</code></pre>`);
                    continue;
                }

                const isTableRow = value => /^\s*\|?.+\|.+\|?\s*$/.test(value);
                const isTableSeparator = value => /^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$/.test(value);
                const tableCells = value => value.trim().replace(/^\||\|$/g, '').split('|').map(cell => cell.trim());
                if (isTableRow(line) && index + 1 < lines.length && isTableSeparator(lines[index + 1])) {
                    const headers = tableCells(line);
                    const rows = [];
                    index += 2;
                    while (index < lines.length && isTableRow(lines[index]) && !isTableSeparator(lines[index])) {
                        rows.push(tableCells(lines[index]));
                        index += 1;
                    }
                    index -= 1;
                    const headerHtml = headers.map(header => `<th>${renderInlineMarkdown(header)}</th>`).join('');
                    const rowsHtml = rows.map(row => `<tr>${headers.map((_, cellIndex) => `<td>${renderInlineMarkdown(row[cellIndex] ?? '')}</td>`).join('')}</tr>`).join('');
                    html.push(`<div class="table-responsive"><table class="table table-row-bordered table-row-gray-300 align-middle mb-5 markdown-table"><thead><tr>${headerHtml}</tr></thead><tbody>${rowsHtml}</tbody></table></div>`);
                    continue;
                }

                const heading = /^(#{1,6})\s+(.+)$/.exec(line);
                if (heading) {
                    const level = heading[1].length;
                    html.push(`<h${level}>${renderInlineMarkdown(heading[2])}</h${level}>`);
                    continue;
                }

                if (/^\s*(-{3,}|\*{3,}|_{3,})\s*$/.test(line)) {
                    html.push('<hr>');
                    continue;
                }

                if (/^>\s?/.test(line)) {
                    const quote = [];
                    do {
                        quote.push(lines[index].replace(/^>\s?/, ''));
                        index += 1;
                    } while (index < lines.length && /^>\s?/.test(lines[index]));
                    index -= 1;
                    html.push(`<blockquote>${renderInlineMarkdown(quote.join(' '))}</blockquote>`);
                    continue;
                }

                const unordered = /^\s*[-*+]\s+(.+)$/.exec(line);
                const ordered = /^\s*\d+\.\s+(.+)$/.exec(line);
                if (unordered || ordered) {
                    const isOrdered = Boolean(ordered);
                    const items = [];
                    const expression = isOrdered ? /^\s*\d+\.\s+(.+)$/ : /^\s*[-*+]\s+(.+)$/;
                    do {
                        const item = expression.exec(lines[index])?.[1] ?? '';
                        const task = /^\[([ xX])\]\s+(.+)$/.exec(item);
                        items.push(task
                            ? `<li class="markdown-task"><input type="checkbox" disabled ${task[1].toLowerCase() === 'x' ? 'checked' : ''}> ${renderInlineMarkdown(task[2])}</li>`
                            : `<li>${renderInlineMarkdown(item)}</li>`);
                        index += 1;
                    } while (index < lines.length && expression.test(lines[index]));
                    index -= 1;
                    html.push(`<${isOrdered ? 'ol' : 'ul'}>${items.join('')}</${isOrdered ? 'ol' : 'ul'}>`);
                    continue;
                }

                if (line.trim()) html.push(`<p>${renderInlineMarkdown(line)}</p>`);
            }

            draftPreview.innerHTML = html.length
                ? html.join('')
                : '<div class="text-muted text-center py-10">A pré-visualização aparecerá aqui.</div>';
        };

        const escapeRegularExpression = value => String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

        const persistImageWidth = (imageUrl, alt, width) => {
            const safeImageUrl = safeUrl(imageUrl, true);
            if (!safeImageUrl) return false;

            const renderedImage = `<img src="${safeImageUrl}" alt="${escapeHtml(alt)}" width="${width}">`;
            const existingImage = new RegExp(`<img\\s+src="${escapeRegularExpression(safeImageUrl)}"\\s+alt="[^"]*"\\s+width="\\d{1,4}"\\s*\\/?>`, 'i');
            if (existingImage.test(draft.value)) {
                draft.value = draft.value.replace(existingImage, renderedImage);
                draft.dispatchEvent(new Event('input', { bubbles: true }));
                return true;
            }

            const markdownImage = /!\[([^\]]*)\]\(([^\s)]+)\)/g;
            let match;
            while ((match = markdownImage.exec(draft.value)) !== null) {
                if (safeUrl(match[2], true) !== safeImageUrl) continue;
                draft.value = `${draft.value.slice(0, match.index)}${renderedImage}${draft.value.slice(match.index + match[0].length)}`;
                draft.dispatchEvent(new Event('input', { bubbles: true }));
                return true;
            }
            return false;
        };

        const promptForImageWidth = async image => {
            const imageUrl = image.dataset.editorImageUrl || image.currentSrc || image.src;
            const currentWidth = Math.round(image.getBoundingClientRect().width) || image.naturalWidth || 400;
            const result = await Swal.fire({
                title: 'Redimensionar imagem',
                input: 'number',
                inputLabel: 'Largura da imagem (pixels)',
                inputValue: currentWidth,
                inputAttributes: { min: '80', max: '2000', step: '10' },
                html: '<div class="text-muted fs-7 mt-2">A largura será gravada no Markdown e enviada ao OpenProject.</div>',
                showCancelButton: true,
                confirmButtonText: 'Aplicar',
                cancelButtonText: 'Cancelar',
                inputValidator: value => {
                    const width = Number(value);
                    return Number.isInteger(width) && width >= 80 && width <= 2000
                        ? undefined
                        : 'Informe uma largura entre 80 e 2.000 pixels.';
                }
            });
            if (!result.isConfirmed) return;

            if (!persistImageWidth(imageUrl, image.alt || 'Imagem da User Story', Number(result.value))) {
                await Swal.fire({ icon: 'error', text: 'Não foi possível localizar esta imagem no Markdown.' });
            }
        };

        const updateDraftMetadata = () => {
            draftCharacterCount.textContent = `${draft.value.length.toLocaleString('pt-BR')} caracteres`;
            if (isPreviewMode) renderMarkdownPreview(draft.value);
        };

        const replaceDraftRange = (replacement, start, end, selectionStart, selectionEnd) => {
            draft.setRangeText(replacement, start, end, 'preserve');
            draft.setSelectionRange(selectionStart ?? start + replacement.length, selectionEnd ?? start + replacement.length);
            draft.focus();
            draft.dispatchEvent(new Event('input', { bubbles: true }));
        };

        const replaceDraftSelection = (replacement, selectionStart, selectionEnd) =>
            replaceDraftRange(replacement, draft.selectionStart, draft.selectionEnd, selectionStart, selectionEnd);

        const wrapDraftSelection = (prefix, suffix, placeholder) => {
            const selected = draft.value.slice(draft.selectionStart, draft.selectionEnd) || placeholder;
            const start = draft.selectionStart;
            replaceDraftSelection(`${prefix}${selected}${suffix}`, start + prefix.length, start + prefix.length + selected.length);
        };

        const prefixDraftLines = (prefixFactory, removePattern) => {
            const selectionStart = draft.selectionStart;
            const selectionEnd = draft.selectionEnd;
            const lineStart = draft.value.lastIndexOf('\n', selectionStart - 1) + 1;
            const nextLineBreak = draft.value.indexOf('\n', selectionEnd);
            const lineEnd = nextLineBreak === -1 ? draft.value.length : nextLineBreak;
            const selectedLines = draft.value.slice(lineStart, lineEnd).split('\n');
            const replacement = selectedLines.map((line, index) => `${prefixFactory(index)}${line.replace(removePattern, '')}`).join('\n');
            draft.setRangeText(replacement, lineStart, lineEnd, 'preserve');
            draft.setSelectionRange(lineStart, lineStart + replacement.length);
            draft.focus();
            draft.dispatchEvent(new Event('input', { bubbles: true }));
        };

        const updateBlockFormatLabel = () => {
            const lineStart = draft.value.lastIndexOf('\n', draft.selectionStart - 1) + 1;
            const currentLine = draft.value.slice(lineStart, draft.value.indexOf('\n', lineStart) === -1 ? draft.value.length : draft.value.indexOf('\n', lineStart));
            const headingLevel = /^(#{1,5})\s+/.exec(currentLine)?.[1].length;
            const label = headingLevel ? `Título ${headingLevel}` : 'Parágrafo';
            blockFormatLabel.textContent = label;
            document.querySelectorAll('[data-block-format-label]').forEach(item => {
                item.classList.toggle('active', item.dataset.blockFormatLabel === label);
            });
        };

        const promptForLink = async () => {
            const selectionStart = draft.selectionStart;
            const selectionEnd = draft.selectionEnd;
            const selected = draft.value.slice(selectionStart, selectionEnd);
            const result = await Swal.fire({
                title: 'Inserir link',
                html: `
                    <div class="text-start">
                        <label class="form-label" for="markdownLinkText">Texto do link</label>
                        <input id="markdownLinkText" class="form-control mb-4" value="${escapeHtml(selected)}" placeholder="Texto exibido no documento">
                        <label class="form-label" for="markdownLinkUrl">Endereço do link</label>
                        <input id="markdownLinkUrl" class="form-control" type="url" placeholder="https://exemplo.com">
                        <label class="form-check form-check-custom form-check-solid mt-4">
                            <input id="markdownLinkNewTab" class="form-check-input" type="checkbox" checked>
                            <span class="form-check-label">Abrir em nova guia</span>
                        </label>
                    </div>`,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Inserir',
                cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const text = document.getElementById('markdownLinkText').value.trim();
                    const url = document.getElementById('markdownLinkUrl').value.trim();
                    if (!text) {
                        Swal.showValidationMessage('Informe o texto que será exibido para o link.');
                        return false;
                    }
                    if (!safeUrl(url)) {
                        Swal.showValidationMessage('Informe uma URL http(s) ou mailto válida.');
                        return false;
                    }
                    return { text, url, openInNewTab: document.getElementById('markdownLinkNewTab').checked };
                }
            });
            if (!result.isConfirmed) return;
            const { text, url, openInNewTab } = result.value;
            const safeLinkUrl = safeUrl(url);
            const markdown = openInNewTab
                ? `<a href="${safeLinkUrl}" target="_blank" rel="noopener noreferrer">${text}</a>`
                : `[${text}](${safeLinkUrl})`;
            replaceDraftRange(markdown, selectionStart, selectionEnd);
        };

        const promptForInlineCode = async () => {
            const selectionStart = draft.selectionStart;
            const selectionEnd = draft.selectionEnd;
            const selected = draft.value.slice(selectionStart, selectionEnd);
            const result = await Swal.fire({
                title: 'Inserir código em linha',
                input: 'text',
                inputLabel: 'Código',
                inputValue: selected,
                inputPlaceholder: 'Ex.: meuMetodo() ou variavel',
                showCancelButton: true,
                confirmButtonText: 'Inserir',
                cancelButtonText: 'Cancelar',
                inputValidator: value => value.trim() ? undefined : 'Informe o código que será inserido.'
            });
            if (!result.isConfirmed) return;
            replaceDraftRange(`\`${result.value.trim()}\``, selectionStart, selectionEnd);
        };

        const promptForCodeBlock = async () => {
            const selectionStart = draft.selectionStart;
            const selectionEnd = draft.selectionEnd;
            const selected = draft.value.slice(selectionStart, selectionEnd);
            const result = await Swal.fire({
                title: 'Inserir bloco de código',
                html: `
                    <div class="text-start">
                        <label class="form-label" for="markdownCodeLanguage">Linguagem</label>
                        <select id="markdownCodeLanguage" class="form-select">
                            <option value="">Texto simples</option>
                            <option value="csharp">C#</option>
                            <option value="javascript">JavaScript</option>
                            <option value="typescript">TypeScript</option>
                            <option value="html">HTML</option>
                            <option value="css">CSS</option>
                            <option value="json">JSON</option>
                            <option value="sql">SQL</option>
                            <option value="bash">Bash</option>
                            <option value="python">Python</option>
                            <option value="other">Outra</option>
                        </select>
                        <input id="markdownCustomCodeLanguage" class="form-control mt-3 d-none" maxlength="40" placeholder="Ex.: yaml, xml, powershell">
                        <label class="form-label mt-4" for="markdownCodeValue">Código</label>
                        <textarea id="markdownCodeValue" class="form-control font-monospace" rows="8" placeholder="Digite ou cole o código aqui">${escapeHtml(selected)}</textarea>
                    </div>`,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Inserir',
                cancelButtonText: 'Cancelar',
                didOpen: () => {
                    const languageSelect = document.getElementById('markdownCodeLanguage');
                    const customLanguage = document.getElementById('markdownCustomCodeLanguage');
                    languageSelect.addEventListener('change', () => customLanguage.classList.toggle('d-none', languageSelect.value !== 'other'));
                },
                preConfirm: () => {
                    const languageSelect = document.getElementById('markdownCodeLanguage');
                    const customLanguage = document.getElementById('markdownCustomCodeLanguage');
                    const language = (languageSelect.value === 'other' ? customLanguage.value : languageSelect.value).trim().toLowerCase();
                    if (language && !/^[a-z0-9+#._-]{1,40}$/i.test(language)) {
                        Swal.showValidationMessage('Informe um identificador de linguagem válido.');
                        return false;
                    }
                    return { language, code: document.getElementById('markdownCodeValue').value };
                }
            });
            if (!result.isConfirmed) return;
            replaceDraftRange(`\n\n\`\`\`${result.value.language}\n${result.value.code}\n\`\`\`\n\n`, selectionStart, selectionEnd);
        };

        const promptForImage = async () => {
            const result = await Swal.fire({
                title: 'Inserir imagem',
                html: '<div class="text-muted fs-7">A imagem será referenciada pela URL e renderizada no OpenProject.</div>',
                input: 'url',
                inputLabel: 'URL da imagem',
                inputPlaceholder: 'https://exemplo.com/imagem.png',
                showCancelButton: true,
                confirmButtonText: 'Inserir',
                cancelButtonText: 'Cancelar',
                inputValidator: value => safeUrl(value, true) ? undefined : 'Informe uma URL http(s) válida para a imagem.'
            });
            if (!result.isConfirmed) return;
            const alt = draft.value.slice(draft.selectionStart, draft.selectionEnd) || 'Imagem da User Story';
            replaceDraftSelection(`![${alt}](${result.value.trim()})`);
        };

        const promptForTable = async () => {
            const result = await Swal.fire({
                title: 'Inserir tabela',
                html: `
                    <div class="row g-3 text-start">
                        <div class="col-6"><label class="form-label" for="markdownTableColumns">Colunas</label><input id="markdownTableColumns" class="form-control" type="number" min="1" max="10" value="3"></div>
                        <div class="col-6"><label class="form-label" for="markdownTableRows">Linhas de dados</label><input id="markdownTableRows" class="form-control" type="number" min="1" max="20" value="2"></div>
                    </div>`,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Inserir',
                cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const columns = Number(document.getElementById('markdownTableColumns').value);
                    const rows = Number(document.getElementById('markdownTableRows').value);
                    if (!Number.isInteger(columns) || columns < 1 || columns > 10 || !Number.isInteger(rows) || rows < 1 || rows > 20) {
                        Swal.showValidationMessage('Informe de 1 a 10 colunas e de 1 a 20 linhas.');
                        return false;
                    }
                    return { columns, rows };
                }
            });
            if (!result.isConfirmed) return;

            const headers = Array.from({ length: result.value.columns }, (_, index) => `Coluna ${index + 1}`);
            const separator = headers.map(() => '---');
            const rows = Array.from({ length: result.value.rows }, () => headers.map(() => 'Valor'));
            replaceDraftSelection(`\n\n| ${headers.join(' | ')} |\n| ${separator.join(' | ')} |\n${rows.map(row => `| ${row.join(' | ')} |`).join('\n')}\n\n`);
        };

        const uploadEditorImage = async file => {
            if (!(file instanceof Blob)) return;
            if (file.size === 0) {
                await Swal.fire({ icon: 'warning', text: 'A imagem selecionada está vazia.' });
                return;
            }
            if (file.size > maxWorkspaceImageBytes) {
                await Swal.fire({ icon: 'warning', text: 'A imagem deve ter no máximo 8 MB.' });
                return;
            }
            if (file.type && !['image/png', 'image/jpeg', 'image/gif', 'image/webp'].includes(file.type)) {
                await Swal.fire({ icon: 'warning', text: 'Envie uma imagem PNG, JPEG, GIF ou WebP.' });
                return;
            }

            const fileName = file instanceof File && file.name ? file.name : 'imagem-colada.png';
            const formData = new FormData();
            formData.append('image', file, fileName);
            Swal.fire({
                title: 'Enviando imagem',
                text: 'A imagem será armazenada e inserida na User Story.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const response = await fetch('/ServiceDesk/UploadWorkspaceImage/@Model.Id', { method: 'POST', body: formData });
                const payload = await response.json().catch(() => ({}));
                if (!response.ok || !payload.url) throw new Error(payload.message || 'Não foi possível enviar a imagem.');

                Swal.close();
                const alt = fileName.replace(/\.[^.]+$/, '') || 'Imagem da User Story';
                const url = new URL(payload.url, window.location.origin).href;
                replaceDraftSelection(`![${alt}](${url})`);
                Swal.fire({ icon: 'success', title: 'Imagem inserida', text: 'Salve o rascunho para manter a referência no documento.', timer: 1800, showConfirmButton: false });
            } catch (error) {
                Swal.close();
                await Swal.fire({ icon: 'error', text: error.message || 'Não foi possível enviar a imagem.' });
            }
        };

        const runEditorAction = async action => {
            switch (action) {
                case 'paragraph': prefixDraftLines(() => '', /^#{1,6}\s+/); break;
                case 'heading1': prefixDraftLines(() => '# ', /^#{1,6}\s+/); break;
                case 'heading2': prefixDraftLines(() => '## ', /^#{1,6}\s+/); break;
                case 'heading3': prefixDraftLines(() => '### ', /^#{1,6}\s+/); break;
                case 'heading4': prefixDraftLines(() => '#### ', /^#{1,6}\s+/); break;
                case 'heading5': prefixDraftLines(() => '##### ', /^#{1,6}\s+/); break;
                case 'bold': wrapDraftSelection('**', '**', 'texto em negrito'); break;
                case 'italic': wrapDraftSelection('*', '*', 'texto em itálico'); break;
                case 'strike': wrapDraftSelection('~~', '~~', 'texto tachado'); break;
                case 'highlight': wrapDraftSelection('==', '==', 'texto destacado'); break;
                case 'inlineCode': await promptForInlineCode(); break;
                case 'bulletList': prefixDraftLines(() => '- ', /^\s*[-*+]\s+/); break;
                case 'orderedList': prefixDraftLines(index => `${index + 1}. `, /^\s*\d+\.\s+/); break;
                case 'taskList': prefixDraftLines(() => '- [ ] ', /^\s*[-*+]\s+(\[[ xX]\]\s+)?/); break;
                case 'quote': prefixDraftLines(() => '> ', /^>\s?/); break;
                case 'codeBlock': await promptForCodeBlock(); break;
                case 'link': await promptForLink(); break;
                case 'table': await promptForTable(); break;
                case 'image': await promptForImage(); break;
                case 'uploadImage': storyImageUpload.click(); break;
                case 'divider': replaceDraftSelection('\n\n---\n\n'); break;
            }
            if (action === 'paragraph' || action.startsWith('heading')) requestAnimationFrame(updateBlockFormatLabel);
        };

        document.getElementById('storyEditorToolbar').addEventListener('click', async event => {
            const button = event.target.closest('[data-editor-action]');
            if (!button) return;
            await runEditorAction(button.dataset.editorAction);
            button.blur();
            document.querySelectorAll('#storyEditorToolbar [data-bs-toggle="dropdown"]').forEach(toggle => {
                bootstrap.Dropdown.getOrCreateInstance(toggle).hide();
            });
        });

        previewToggle.addEventListener('click', () => {
            isPreviewMode = !isPreviewMode;
            draft.classList.toggle('d-none', isPreviewMode);
            draftPreview.classList.toggle('d-none', !isPreviewMode);
            previewToggle.classList.toggle('btn-primary', isPreviewMode);
            previewToggle.classList.toggle('btn-light-primary', !isPreviewMode);
            previewToggle.querySelector('span').textContent = isPreviewMode ? 'Editar Markdown' : 'Visualizar';
            previewToggle.querySelector('i').className = `ki-duotone ${isPreviewMode ? 'ki-pencil' : 'ki-eye'} fs-4`;
            if (isPreviewMode) renderMarkdownPreview(draft.value);
            else draft.focus();
        });

        draft.addEventListener('input', updateDraftMetadata);
        draft.addEventListener('click', updateBlockFormatLabel);
        draft.addEventListener('keyup', updateBlockFormatLabel);
        storyImageUpload.addEventListener('change', async () => {
            const [file] = storyImageUpload.files;
            storyImageUpload.value = '';
            if (file) await uploadEditorImage(file);
        });
        draft.addEventListener('paste', async event => {
            const clipboardImage = Array.from(event.clipboardData?.items ?? [])
                .find(item => item.type.startsWith('image/'));
            if (!clipboardImage) return;

            const image = clipboardImage.getAsFile();
            if (!image) return;
            event.preventDefault();
            await uploadEditorImage(image);
        });
        draft.addEventListener('keydown', event => {
            if (!event.ctrlKey && !event.metaKey) return;
            const shortcut = event.key.toLowerCase();
            if (shortcut === 'b') { event.preventDefault(); wrapDraftSelection('**', '**', 'texto em negrito'); }
            if (shortcut === 'i') { event.preventDefault(); wrapDraftSelection('*', '*', 'texto em itálico'); }
            if (shortcut === 'k') { event.preventDefault(); promptForLink(); }
        });
        draftPreview.addEventListener('click', event => {
            const image = event.target.closest('img[data-editor-image-url]');
            if (image) promptForImageWidth(image);
        });
        document.querySelectorAll('#storyEditorToolbar [title]').forEach(element => new bootstrap.Tooltip(element));
        updateDraftMetadata();
        updateBlockFormatLabel();

        document.getElementById('saveDraft').onclick = async () => {
            const response = await fetch('/ServiceDesk/SaveDraft/@Model.Id', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ requirementMarkdown: draft.value })
            });
            Swal.fire({ icon: response.ok ? 'success' : 'error', text: response.ok ? 'Rascunho salvo com sucesso.' : 'Não foi possível salvar o rascunho.' });
        };

        const projectSelect = document.getElementById('openProjectProject');
        const createUserStoryButton = document.getElementById('createUserStory');
        const hasExistingUserStory = @hasLinkedUserStory.ToString().ToLowerInvariant();

        const loadOpenProjectProjects = async () => {
            if (!projectSelect) return;

            createUserStoryButton?.setAttribute('disabled', 'disabled');
            try {
                const response = await fetch('/ServiceDesk/OpenProjectProjects');
                const projects = await response.json();
                if (!response.ok) throw new Error(projects.message || 'Não foi possível carregar os projetos do OpenProject.');

                projects.forEach(project => {
                    const label = project.identifier ? `${project.name} (${project.identifier})` : project.name;
                    projectSelect.add(new Option(label, project.id));
                });

                if (window.jQuery && !window.jQuery(projectSelect).hasClass('select2-hidden-accessible')) {
                    window.jQuery(projectSelect).select2({
                        placeholder: 'Selecione o projeto para esta User Story',
                        width: '100%'
                    });
                }
            } catch (error) {
                Swal.fire({ icon: 'error', text: error.message || 'Não foi possível carregar os projetos do OpenProject.' });
            } finally {
                createUserStoryButton?.removeAttribute('disabled');
            }
        };

        createUserStoryButton?.addEventListener('click', async () => {
            const projectId = Number(projectSelect?.value);
            const requirementMarkdown = draft.value;
            if (!hasExistingUserStory && !projectId) {
                Swal.fire({ icon: 'warning', text: 'Selecione o projeto de destino no OpenProject.' });
                return;
            }

            if (!hasExistingUserStory && !requirementMarkdown.trim()) {
                Swal.fire({ icon: 'warning', text: 'Documente a User Story antes de criá-la.' });
                return;
            }

            createUserStoryButton.setAttribute('disabled', 'disabled');
            createUserStoryButton.setAttribute('data-kt-indicator', 'on');
            try {
                const response = hasExistingUserStory
                    ? await fetch('/ServiceDesk/ReprocessGlpiLink/@Model.Id', { method: 'POST' })
                    : await fetch('/ServiceDesk/CreateUserStory/@Model.Id', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ projectId, requirementMarkdown })
                    });
                const payload = await response.json();
                if (!response.ok) throw new Error(payload.message || 'Não foi possível concluir a operação.');

                await Swal.fire({
                    icon: 'success',
                    text: hasExistingUserStory
                        ? 'O vínculo foi incluído na fila de sincronização do GLPI.'
                        : 'User Story criada no OpenProject. O vínculo com o GLPI será sincronizado automaticamente.'
                });
                window.location.reload();
            } catch (error) {
                const message = error.message || 'Não foi possível concluir a criação da User Story.';
                await Swal.fire({ icon: 'error', text: message });

                // A Work Package pode ter sido persistida antes de uma falha no GLPI.
                // Recarregar permite visualizar o estado salvo e repetir somente o vínculo pendente.
                if (message.includes('User Story foi criada')) window.location.reload();
            } finally {
                createUserStoryButton.removeAttribute('disabled');
                createUserStoryButton.removeAttribute('data-kt-indicator');
            }
        });

        if (!hasExistingUserStory) loadOpenProjectProjects();

        document.querySelectorAll('.glpi-ticket-frame').forEach(frame => frame.addEventListener('load', () => {
            const body = frame.contentDocument?.body;
            if (!body) return;

            applyTicketTheme(frame);
            frame.style.height = `${Math.max(body.scrollHeight + 8, 360)}px`;
            body.addEventListener('click', event => {
                const image = event.target.closest('img');
                if (!image || !image.currentSrc.includes('/ServiceDesk/Attachment/')) return;
                event.preventDefault();
                event.stopPropagation();
                openAttachmentPreview(image.currentSrc);
            });
            KTScroll.getInstance(document.getElementById('glpiTicketScroll'))?.update();
        }));

        KTScroll.createInstances('#glpiTicketScroll');
        document.querySelectorAll('.attachment-thumb').forEach(item => item.addEventListener('click', () => openAttachmentPreview(item.dataset.imageUrl)));
        new MutationObserver(() => document.querySelectorAll('.glpi-ticket-frame').forEach(applyTicketTheme)).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
    </script>
}

