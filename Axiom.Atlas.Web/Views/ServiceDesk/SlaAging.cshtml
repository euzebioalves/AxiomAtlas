@{
    ViewData["Title"] = "SLA e envelhecimento";
}

<div class="app-content flex-column-fluid" id="kt_app_content"><div class="app-container container-fluid"><div class="d-flex flex-column gap-7">
    <div class="card aging-hero"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-5 py-7"><div><span class="badge badge-light-primary mb-3">Visão gerencial</span><h1 class="fs-2x fw-bold mb-2">SLA e envelhecimento</h1><p class="text-gray-600 fw-semibold mb-0">Acompanhe a idade das demandas, identifique filas envelhecidas e reduza o risco de atraso operacional.</p><p id="aging-synchronization" class="text-gray-500 fs-7 mt-3 mb-0"></p></div><div class="d-flex flex-wrap gap-3"><button type="button" class="btn btn-light-primary management-help-trigger" data-management-help-key="sla" data-management-help-title="Como interpretar SLA e envelhecimento"><span class="management-help-question me-2">?</span>Como interpretar</button><a asp-action="Dashboard" class="btn btn-light-primary">Painel executivo</a><button id="aging-refresh" type="button" class="btn btn-primary">Atualizar fontes</button></div></div></div>
    <div id="aging-error" class="alert alert-danger d-none mb-0"><span id="aging-error-message"></span></div>
    <div id="aging-loading" class="card"><div class="card-body d-flex align-items-center justify-content-center gap-3 py-12"><span class="spinner-border text-primary"></span><span class="fw-semibold text-gray-600">Calculando o envelhecimento da fila...</span></div></div>
    <div id="aging-content" class="d-none d-flex flex-column gap-7">
        <div class="row g-5" id="aging-kpis"></div>
        <div class="row g-7"><div class="col-xl-7"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Faixas de envelhecimento <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="sla" data-management-help-title="Faixas de envelhecimento"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Aging operacional das demandas ainda não concluídas.</span></div></div><div class="card-body pt-2" id="aging-bands"></div></div></div><div class="col-xl-5"><div class="card h-100"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Encaminhamento técnico <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="technical-lead-time" data-management-help-title="Tempo até a User Story"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Do chamado GLPI até a criação da Work Package.</span></div></div><div class="card-body pt-2" id="aging-lead-time"></div></div></div></div>
        <div class="card"><div class="card-header border-0 pt-6"><div class="card-title flex-column align-items-start"><h2 class="fw-bold fs-3 mb-1">Fila de envelhecimento prioritária <button type="button" class="btn btn-icon btn-sm btn-active-light-primary management-help-trigger" data-management-help-key="aging-queue" data-management-help-title="Fila de envelhecimento prioritária"><span class="management-help-icon text-primary">?</span></button></h2><span class="text-gray-500 fw-semibold fs-7">Chamados abertos há mais tempo, com destaque para risco e criticidade.</span></div></div><div class="card-body pt-0"><div class="table-responsive"><table class="table table-row-dashed align-middle gs-0 gy-4 mb-0"><thead><tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase"><th>Demanda</th><th>Faixa</th><th>Cliente</th><th>Encaminhamento técnico</th><th>Motivo</th><th class="text-end">Ação</th></tr></thead><tbody id="aging-queue"></tbody></table></div></div></div>
    </div>
</div></div></div>

<partial name="_ManagementDashboardHelp" />

<style>
    .aging-hero { background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), .10), rgba(var(--bs-danger-rgb), .05)); }
    .aging-kpi { min-height: 150px; } .aging-kpi-value { font-size: 2rem; line-height: 1; }
    .aging-item + .aging-item { border-top: 1px dashed var(--bs-border-color); }
    .aging-bar { height: 9px; border-radius: 99px; background: var(--bs-gray-200); overflow: hidden; } .aging-bar > span { display: block; height: 100%; border-radius: inherit; }
    [data-bs-theme="dark"] .aging-bar { background: #242838; }
</style>

<script>
    (() => {
        const loading = document.getElementById('aging-loading'), content = document.getElementById('aging-content'), error = document.getElementById('aging-error'), errorMessage = document.getElementById('aging-error-message'), refreshButton = document.getElementById('aging-refresh');
        const dataUrl = '@Url.Action("DashboardData", "ServiceDesk")', refreshUrl = '@Url.Action("RefreshKanban", "ServiceDesk")', detailsUrl = '@Url.Action("DashboardDetails", "ServiceDesk")';
        const escapeHtml = value => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        const formatDateTime = value => value ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(value)) : 'Ainda não sincronizada';
        const formatInterval = seconds => seconds >= 60 ? `${Math.round(seconds / 60)} min` : `${seconds} s`;
        const bands = [{ label: 'Até 7 dias', color: 'success', test: days => days <= 7 }, { label: '8 a 15 dias', color: 'primary', test: days => days >= 8 && days <= 15 }, { label: '16 a 30 dias', color: 'warning', test: days => days >= 16 && days <= 30 }, { label: 'Mais de 30 dias', color: 'danger', test: days => days > 30 }];
        const priorityClass = priority => priority === 'Crítica' ? 'danger' : priority === 'Alta' ? 'warning' : 'primary';
        const getBand = days => bands.find(band => band.test(days)) || bands[0];
        const technicalLeadTime = item => { if (!item.openedAt || !item.workPackageCreatedAt) return null; const days = Math.floor((new Date(item.workPackageCreatedAt) - new Date(item.openedAt)) / 86400000); return days >= 0 ? days : null; };

        async function loadAging() { loading.classList.remove('d-none'); content.classList.add('d-none'); error.classList.add('d-none'); try { const response = await fetch(dataUrl); const raw = await response.text(); let payload; try { payload = raw ? JSON.parse(raw) : null; } catch { throw new Error(`A consulta retornou uma resposta inválida (HTTP ${response.status}).`); } if (!response.ok || !payload) throw new Error(payload?.message || payload?.detail || `Não foi possível carregar o envelhecimento (HTTP ${response.status}).`); renderAging(payload); content.classList.remove('d-none'); } catch (exception) { errorMessage.textContent = exception.message; error.classList.remove('d-none'); } finally { loading.classList.add('d-none'); } }

        function renderAging(payload) {
            const items = payload.items || [], openItems = items.filter(item => item.stage !== 'completed'), leadTimes = openItems.map(technicalLeadTime).filter(value => value !== null), averageAge = openItems.length ? Math.round(openItems.reduce((total, item) => total + (item.daysOpen || 0), 0) / openItems.length) : 0, averageLeadTime = leadTimes.length ? Math.round(leadTimes.reduce((total, value) => total + value, 0) / leadTimes.length) : null;
            document.getElementById('aging-synchronization').textContent = payload.synchronizationPending ? 'Uma atualização está em andamento. As faixas serão reconciliadas em segundo plano.' : `Projeção local atualizada em ${formatDateTime(payload.lastSynchronizedAt)}. Fontes reconciliadas a cada ${formatInterval(payload.synchronizationIntervalSeconds || 300)}.`;
            const kpis = [['Aging acima de 30 dias', openItems.filter(item => (item.daysOpen || 0) > 30).length, 'Demandas fora da faixa operacional', 'danger'], ['Idade média', `${averageAge} dias`, 'Tempo médio das demandas abertas', 'warning'], ['Maior espera', `${Math.max(...openItems.map(item => item.daysOpen || 0), 0)} dias`, 'Item aberto há mais tempo', 'info'], ['Tempo até a User Story', averageLeadTime === null ? '—' : `${averageLeadTime} dias`, leadTimes.length ? `${leadTimes.length} demanda(s) com datas válidas` : 'Sem pares de datas para calcular', 'primary']];
            document.getElementById('aging-kpis').innerHTML = kpis.map(([title, value, subtitle, color]) => `<div class="col-md-6 col-xl-3"><div class="card aging-kpi border border-${color} border-opacity-25"><div class="card-body"><div class="aging-kpi-value fw-bold text-${color}">${value}</div><div class="fw-bold mt-3">${title}</div><div class="text-gray-500 fs-7">${subtitle}</div></div></div></div>`).join('');
            const total = Math.max(openItems.length, 1);
            document.getElementById('aging-bands').innerHTML = bands.map(band => { const filtered = openItems.filter(item => band.test(item.daysOpen || 0)); return `<div class="aging-item py-4"><div class="d-flex align-items-center justify-content-between mb-2"><span class="fw-bold"><span class="badge badge-light-${band.color} me-2">${band.label}</span> demandas abertas</span><span class="fw-bold text-${band.color}">${filtered.length}</span></div><div class="aging-bar"><span class="bg-${band.color}" style="width:${(filtered.length / total) * 100}%"></span></div></div>`; }).join('');
            const leadGroups = [{ label: 'Sem User Story', color: 'danger', amount: openItems.filter(item => !item.workPackageId).length }, { label: 'Criada em até 7 dias', color: 'success', amount: leadTimes.filter(days => days <= 7).length }, { label: 'Criada de 8 a 30 dias', color: 'warning', amount: leadTimes.filter(days => days >= 8 && days <= 30).length }, { label: 'Criada após 30 dias', color: 'danger', amount: leadTimes.filter(days => days > 30).length }];
            document.getElementById('aging-lead-time').innerHTML = leadGroups.map(group => `<div class="aging-item py-4"><div class="d-flex align-items-center justify-content-between mb-2"><span class="fw-bold text-gray-800">${group.label}</span><span class="badge badge-light-${group.color}">${group.amount}</span></div><div class="aging-bar"><span class="bg-${group.color}" style="width:${(group.amount / total) * 100}%"></span></div></div>`).join('');
            const queue = [...openItems].sort((a, b) => (b.daysOpen || 0) - (a.daysOpen || 0) || (b.priority === 'Crítica') - (a.priority === 'Crítica')).slice(0, 20);
            document.getElementById('aging-queue').innerHTML = queue.length ? queue.map(item => { const band = getBand(item.daysOpen || 0), lead = technicalLeadTime(item), action = item.workspaceId ? `/ServiceDesk/Workspace/${item.workspaceId}?returnSource=aging` : `${detailsUrl}?${new URLSearchParams({ client: item.clientEntityName || 'Cliente não informado' }).toString()}`; return `<tr><td><div class="fw-bold">#${item.glpiTicketId}</div><div class="text-gray-600 text-truncate" style="max-width:260px">${escapeHtml(item.subject)}</div><div class="text-gray-500 fs-8">${item.daysOpen || 0} dias em aberto</div></td><td><span class="badge badge-light-${band.color}">${band.label}</span><div class="mt-1"><span class="badge badge-light-${priorityClass(item.priority)}">${escapeHtml(item.priority)}</span></div></td><td class="fw-semibold">${escapeHtml(item.clientEntityName || 'Não informado')}</td><td>${lead === null ? '<span class="text-gray-500">Sem User Story</span>' : `<span class="fw-bold">${lead} dias</span><div class="text-gray-500 fs-8">até a WP</div>`}</td><td class="text-gray-600" style="max-width:260px">${escapeHtml(item.priorityReason || 'Revisar o tempo de permanência na fila.')}</td><td class="text-end"><a href="${action}" class="btn btn-sm btn-light-primary">Tratar</a></td></tr>`; }).join('') : '<tr><td colspan="6" class="text-center text-gray-500 py-8">Não há demandas abertas na projeção local.</td></tr>';
        }
        refreshButton.addEventListener('click', async () => { refreshButton.disabled = true; try { await fetch(refreshUrl, { method: 'POST' }); await loadAging(); } finally { refreshButton.disabled = false; } });
        loadAging();
    })();
</script>
